#!/usr/bin/env node

import fs from "node:fs"
import os from "node:os"
import path from "node:path"
import { spawnSync } from "node:child_process"
import { claudeJobStates, renameClaudeThread, walkClaudeTranscripts } from "./lib/claude-transcript-files.mjs"
import { parseClaudeTranscript } from "./lib/claude-transcript-parser.mjs"
import { claudeModels, claudeRuntimeInfo } from "./lib/claude-runtime-models.mjs"
import { claudeAgentsForDirectory, claudeDefaults, claudeSettingsForDirectory } from "./lib/claude-project-config.mjs"
import { claudeUsageRateLimits } from "./lib/claude-usage.mjs"

const [provider = "", action = "snapshot", threadID = "", threadPath = "", actionValue = ""] = process.argv.slice(2)
const home = process.env.OMARCHY_AGENT_PROVIDER_HOME || os.homedir()
const stateHome = process.env.XDG_STATE_HOME || path.join(home, ".local", "state")
const metadataPath = path.join(stateHome, "omarchy", "codex-thread-providers.json")
const claudeRuntimePath = path.join(stateHome, "omarchy", "claude-runtime.json")
const claudeUsagePath = path.join(stateHome, "omarchy", "claude-usage.json")
const claudeThreadRuntimePath = process.env.OMARCHY_CLAUDE_RUNTIME_PATH
  || path.join(stateHome, "omarchy", "claude-thread-runtime.json")
const claudeUsageURL = process.env.OMARCHY_CLAUDE_USAGE_URL
  || "https://api.anthropic.com/api/oauth/usage"
const claudeCommand = process.env.OMARCHY_CLAUDE_COMMAND || "claude"
const MAX_CLAUDE_PROJECT_DIRECTORIES = 256
const MAX_CLAUDE_DIRECTORY_ENTRIES = 1024
const MAX_CLAUDE_DISCOVERED_TRANSCRIPTS = 2048
const MAX_CLAUDE_TRANSCRIPTS = 512
const MAX_CLAUDE_TRANSCRIPT_HEAD_BYTES = 64 * 1024
const MAX_CLAUDE_TRANSCRIPT_TAIL_BYTES = 256 * 1024
const MAX_CLAUDE_SNAPSHOT_BYTES = 32 * 1024 * 1024
const MAX_PROVIDER_JSON_BYTES = 2 * 1024 * 1024
const MAX_CLAUDE_JOBS = 512
const MAX_CLAUDE_AGENT_FILES = 256
const MAX_CLAUDE_AGENT_BYTES = 128 * 1024

function fail(message) {
  process.stderr.write(`${provider || "agent"}: ${message}\n`)
  process.exit(2)
}

function readJSON(filePath, fallback = null) {
  try { return JSON.parse(readBoundedText(filePath, MAX_PROVIDER_JSON_BYTES)) }
  catch { return fallback }
}

function readBoundedText(filePath, maxBytes) {
  const descriptor = fs.openSync(filePath, fs.constants.O_RDONLY)
  try {
    const stat = fs.fstatSync(descriptor)
    if (!stat.isFile() || stat.size > maxBytes) throw new Error("file exceeds read limit")
    const buffer = Buffer.alloc(stat.size)
    let offset = 0
    while (offset < buffer.length) {
      const count = fs.readSync(descriptor, buffer, offset, buffer.length - offset, offset)
      if (count === 0) break
      offset += count
    }
    if (offset !== buffer.length) throw new Error("file changed while being read")
    return buffer.toString("utf8")
  } finally {
    fs.closeSync(descriptor)
  }
}

function writePrivateJSON(filePath, value) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true, mode: 0o700 })
  const temporary = `${filePath}.${process.pid}.tmp`
  fs.writeFileSync(temporary, JSON.stringify(value) + "\n", { mode: 0o600 })
  fs.renameSync(temporary, filePath)
}

function loadMetadata() {
  const value = readJSON(metadataPath, {})
  return value && typeof value === "object" ? value : {}
}

function saveMetadata(value) {
  writePrivateJSON(metadataPath, value)
}

function metadataKey(id) {
  return `${provider}:${id}`
}

function updateLocalMetadata(kind, value) {
  if (!threadID) fail("missing session id")
  const metadata = loadMetadata()
  const key = metadataKey(threadID)
  const entry = metadata[key] && typeof metadata[key] === "object" ? metadata[key] : {}
  if (kind === "pin") entry.pinned = value === "true"
  if (kind === "archive") entry.archived = true
  metadata[key] = entry
  saveMetadata(metadata)
}

function cleanText(value) {
  return String(value || "").replace(/\s+/g, " ").trim()
}

function textContent(content) {
  if (typeof content === "string") return cleanText(content)
  if (!Array.isArray(content)) return ""
  return cleanText(content.map(item => {
    if (typeof item === "string") return item
    return item && item.type === "text" ? item.text : ""
  }).join(" "))
}

function projectName(directory) {
  if (!directory) return "Unknown folder"
  return path.basename(directory.replace(/\/$/, "")) || directory
}

function projectList(threads) {
  const seen = new Set()
  const projects = []
  for (const thread of threads) {
    const directory = String(thread.cwd || "")
    if (!directory || seen.has(directory)) continue
    seen.add(directory)
    projects.push({
      id: directory,
      name: projectName(directory),
      roots: [{ path: directory }]
    })
  }
  return projects
}

function timestampSeconds(value, fallback = 0) {
  if (typeof value === "number") return value > 100000000000 ? value / 1000 : value
  const parsed = Date.parse(String(value || ""))
  return Number.isFinite(parsed) ? parsed / 1000 : fallback
}

async function claudeSnapshot() {
  const configRoot = process.env.CLAUDE_CONFIG_DIR || path.join(home, ".claude")
  const settings = readJSON(path.join(configRoot, "settings.json"), {}) || {}
  const state = readJSON(path.join(home, ".claude.json"), {}) || {}
  const jobs = claudeJobStates()
  const runtimeValue = readJSON(claudeThreadRuntimePath, {}) || {}
  const runtimeStates = new Map(Object.entries(
    runtimeValue.sessions && typeof runtimeValue.sessions === "object"
      ? runtimeValue.sessions : {}))
  const metadata = loadMetadata()
  const readBudget = { remaining: MAX_CLAUDE_SNAPSHOT_BYTES }
  const threads = []
  for (const candidate of walkClaudeTranscripts(path.join(configRoot, "projects"))) {
    const thread = parseClaudeTranscript(candidate, jobs, runtimeStates, metadata, readBudget)
    if (thread) threads.push(thread)
  }
  threads.sort((a, b) => b.updatedAt - a.updatedAt)
  const projects = projectList(threads)
  const defaults = claudeDefaults(configRoot, threads, settings, state)
  const projectDefaults = {}
  const projectAgents = {}
  for (const project of projects) {
    const directory = String(project && project.id || "")
    projectDefaults[directory] = claudeDefaults(
      configRoot,
      threads.filter(thread => String(thread.cwd || "") === directory),
      claudeSettingsForDirectory(configRoot, directory),
      state)
    projectAgents[directory] = claudeAgentsForDirectory(configRoot, directory)
  }
  const configuredModels = [defaults.model].concat(
    Object.values(projectDefaults).map(value => value && value.model))
  const runtime = claudeRuntimeInfo()
  const rateLimits = await claudeUsageRateLimits(configRoot, runtimeValue, runtime.authenticated)
  return {
    hostId: "provider-claude",
    label: "CLAUDE",
    providerType: "claude",
    type: "provider",
    home,
    threads,
    projects,
    projectDefaults,
    projectAgents,
    defaultModel: defaults.model,
    defaultEffort: defaults.effort,
    models: claudeModels(settings, state, configuredModels),
    agents: claudeAgentsForDirectory(configRoot, ""),
    defaultAgent: defaults.agent,
    available: runtime.available,
    authenticated: runtime.authenticated,
    version: runtime.version,
    subscriptionType: runtime.subscriptionType,
    rateLimits,
    error: !runtime.available
      ? "Claude CLI is not installed on this host"
      : (!runtime.authenticated ? "Claude is not signed in; run: claude auth login" : "")
  }
}

async function main() {
  if (provider !== "claude" && provider !== "opencode") fail("unsupported provider")
  const openCode = provider === "opencode"
    ? await import("./lib/opencode-provider.mjs") : null

  if (action === "pin") {
    updateLocalMetadata("pin", actionValue)
    process.stdout.write(JSON.stringify({ ok: true }) + "\n")
    return
  }

  if (action === "archive") {
    if (provider === "claude") updateLocalMetadata("archive", "true")
    else {
      await openCode.archiveOpenCode(threadID, threadPath)
    }
    process.stdout.write(JSON.stringify({ ok: true }) + "\n")
    return
  }

  if (action === "rename") {
    if (provider === "claude") renameClaudeThread(threadID, actionValue)
    else await openCode.renameOpenCode(threadID, threadPath, actionValue)
    process.stdout.write(JSON.stringify({ ok: true }) + "\n")
    return
  }

  if (action !== "snapshot") fail("unsupported action")
  const snapshot = provider === "claude"
    ? await claudeSnapshot() : await openCode.openCodeSnapshot()
  process.stdout.write(JSON.stringify(snapshot) + "\n")
}

main().catch(error => fail(error && error.message ? error.message : String(error)))

#!/usr/bin/env node

import fs from "node:fs"
import os from "node:os"
import path from "node:path"
import { spawn } from "node:child_process"
import { fileURLToPath } from "node:url"
import { bearerToken, createSshTransport, createWebSocketTransport, loadHost } from "./lib/remote-transport.mjs"
import { providerTypeForHost, runRemoteClaude, runRemoteOpenCode } from "./lib/remote-provider-actions.mjs"

const [configPath = "", hostId = "", action = "snapshot", actionValue = "",
  actionExtra = "", actionName = ""] = process.argv.slice(2)
const timeoutMs = 60000
const pinnedSectionId = "01984de2-8f74-7c91-a3b2-5c5e937cf318"
const SSH_STDOUT_LIMIT = 16 * 1024 * 1024
const SSH_STDERR_LIMIT = 256 * 1024
const CONFIG_FILE_LIMIT = 1024 * 1024
const TOKEN_FILE_LIMIT = 64 * 1024
let nextRequestId = 1

function fail(message) {
  process.stderr.write(`Codex remote ${hostId || "host"}: ${message}\n`)
  process.exit(2)
}

async function connect(host) {
  return host.type === "ssh" ? createSshTransport(host) : createWebSocketTransport(host)
}

async function main() {
  const host = loadHost(configPath, hostId)
  if (providerTypeForHost(host) === "claude") {
    await runRemoteClaude(host, { hostId, action, actionValue, actionExtra, actionName })
    return
  }
  if (providerTypeForHost(host) === "opencode") {
    await runRemoteOpenCode(host, { hostId, action, actionValue, actionExtra, actionName })
    return
  }
  const transport = await connect(host)
  const pending = new Map()
  if (transport.setErrorHandler) {
    transport.setErrorHandler(error => {
      for (const callback of pending.values()) callback.reject(error)
      pending.clear()
    })
  }
  transport.setMessageHandler(line => {
    const text = String(line || "").trim()
    if (text === "") return
    let message
    try { message = JSON.parse(text) } catch { return }
    if (message.id === undefined || message.id === null) return
    const callback = pending.get(Number(message.id))
    if (!callback) return
    pending.delete(Number(message.id))
    if (message.error) callback.reject(new Error(String(message.error.message || "App Server request failed")))
    else callback.resolve(message.result || {})
  })

  function request(method, params = {}) {
    const id = nextRequestId++
    return new Promise((resolve, reject) => {
      pending.set(id, { resolve, reject })
      transport.send({ method, id, params })
    })
  }

  await request("initialize", {
    clientInfo: {
      name: "omarchy_codex_threads",
      title: "Omarchy Codex Threads",
      version: "1.0.0"
    },
    capabilities: { experimentalApi: true }
  })
  transport.send({ method: "initialized" })

  if (action === "archive") {
    if (!/^[A-Za-z0-9._-]+$/.test(actionValue)) fail("invalid thread id")
    await request("thread/archive", { threadId: actionValue })
    process.stdout.write(JSON.stringify({ hostId, action, ok: true }) + "\n")
    transport.close()
    return
  }

  if (action === "rename") {
    if (!/^[A-Za-z0-9._-]+$/.test(actionValue)) fail("invalid thread id")
    const name = String(actionName || "").replace(/\s+/g, " ").trim().slice(0, 200)
    if (!name) fail("missing thread name")
    await request("thread/name/set", { threadId: actionValue, name })
    process.stdout.write(JSON.stringify({ hostId, action, ok: true }) + "\n")
    transport.close()
    return
  }

  if (action === "pin") {
    if (!/^[A-Za-z0-9._-]+$/.test(actionValue)) fail("invalid thread id")
    if (actionExtra !== "true" && actionExtra !== "false") fail("invalid pin value")
    const pinned = actionExtra === "true"
    let result = {}
    try {
      result = await request("thread/section/move", {
        threadId: actionValue,
        sectionId: pinned ? pinnedSectionId : null
      })
    } catch (sectionError) {
      // Compatibility with App Servers from before built-in thread sections.
      try {
        result = await request("thread/metadata/update", {
          threadId: actionValue,
          isPinned: pinned
        })
      } catch (metadataError) {
        throw new Error(`${sectionError.message}; legacy fallback: ${metadataError.message}`)
      }
    }
    process.stdout.write(JSON.stringify({
      hostId,
      action,
      ok: true,
      thread: result.thread || null
    }) + "\n")
    transport.close()
    return
  }

  async function listAll(method, firstParams) {
    const items = []
    let cursor = null
    for (let page = 0; page < 20; page++) {
      const params = { ...firstParams }
      if (cursor) params.cursor = cursor
      const result = await request(method, params)
      items.push(...(Array.isArray(result.data) ? result.data : []))
      cursor = result.nextCursor || null
      if (!cursor) break
    }
    return items
  }

  const listedThreads = await listAll("thread/list", {
    limit: 100,
    sortKey: "updated_at",
    sortDirection: "desc"
  })
  const threads = listedThreads.map(thread => {
    const section = thread && thread.section
    const isPinned = thread && thread.isPinned === true
      || section && (String(section.id || "") === pinnedSectionId
        || String(section.name || "").toLowerCase() === "pinned")
    return { ...thread, isPinned: !!isPinned }
  })
  let projects = []
  try {
    projects = await listAll("project/list", { limit: 100 })
  } catch {
    // Older App Servers do not expose projects; cwd grouping still works.
  }

  let remoteHome = String(host.home || "")
  if (remoteHome === "") {
    for (const thread of threads) {
      const cwd = String(thread && thread.cwd || "")
      const match = cwd.match(/^(\/home\/[^/]+|\/Users\/[^/]+)(?:\/|$)/)
      if (match) { remoteHome = match[1]; break }
      if (cwd === "/root" || cwd.startsWith("/root/")) { remoteHome = "/root"; break }
    }
  }

  process.stdout.write(JSON.stringify({
    hostId,
    label: String(host.label || host.id || "Remote"),
    type: host.type === "ssh" ? "ssh" : "app-server",
    home: remoteHome,
    threads,
    projects
  }) + "\n")
  transport.close()
}

const timeout = setTimeout(() => fail("connection timed out"), timeoutMs)
main().then(() => clearTimeout(timeout)).catch(error => fail(error.message))

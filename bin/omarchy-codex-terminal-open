#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${script_dir}/lib/launch-diagnostics.sh"
source "${script_dir}/lib/runtime-state.sh"
agent_threads_launch_log_init

terminal_cwd=""
thread_id=""
mapping_namespace=""
move_to_active_workspace=false
require_terminal_cwd=false
forwarded_command=()
launch_status_dir=""
launch_status_file=""

usage() {
  cat <<'EOF'
Usage: omarchy-codex-terminal-open --terminal-cwd DIR [OPTIONS] -- COMMAND [ARG...]

Terminal adapter options:
  --terminal-cwd DIR          Local directory used by the terminal
  --thread-id ID              Existing Codex thread used for process recovery
  --mapping-namespace NAME    Legacy compatibility option (no state is written)
  --move-to-active-workspace  Move a newly created window to the active workspace
  --require-terminal-cwd      Fail instead of falling back to HOME if DIR is missing
  -h, --help                  Show this help

Everything after -- is forwarded unchanged to the terminal.
EOF
}

fail_usage() {
  agent_threads_launch_log codex-terminal-open invalid-options "error=$1"
  printf '%s\n' "$1" >&2
  printf '%s\n' 'Run with --help for usage.' >&2
  exit 2
}

while (( $# > 0 )); do
  case "$1" in
    --terminal-cwd)
      (( $# >= 2 )) || fail_usage "Missing value for --terminal-cwd"
      terminal_cwd="$2"
      shift 2
      ;;
    --thread-id)
      (( $# >= 2 )) || fail_usage "Missing value for --thread-id"
      thread_id="$2"
      shift 2
      ;;
    --mapping-namespace)
      (( $# >= 2 )) || fail_usage "Missing value for --mapping-namespace"
      mapping_namespace="$2"
      shift 2
      ;;
    --move-to-active-workspace)
      move_to_active_workspace=true
      shift
      ;;
    --require-terminal-cwd)
      require_terminal_cwd=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      forwarded_command=("$@")
      break
      ;;
    *)
      fail_usage "Unknown terminal adapter option: $1"
      ;;
  esac
done

[[ -n "$terminal_cwd" ]] || fail_usage "Missing --terminal-cwd"
(( ${#forwarded_command[@]} > 0 )) || fail_usage "Missing command after --"
if [[ -n "$thread_id" && ! "$thread_id" =~ ^[A-Za-z0-9._-]+$ ]]; then
  fail_usage "Invalid Codex thread id"
fi
if [[ -n "$mapping_namespace" \
    && ! "$mapping_namespace" =~ ^[A-Za-z0-9._-]+$ ]]; then
  fail_usage "Invalid Codex mapping namespace"
fi

requested_terminal_cwd="$terminal_cwd"
if [[ ! -d "$terminal_cwd" ]]; then
  if [[ "$require_terminal_cwd" == true ]]; then
    fail_usage "Invalid terminal directory: $terminal_cwd"
  fi
  terminal_cwd="${HOME}"
fi

remote_url=""
for (( command_index = 0; command_index < ${#forwarded_command[@]}; command_index++ )); do
  case "${forwarded_command[$command_index]}" in
    --remote)
      if (( command_index + 1 < ${#forwarded_command[@]} )); then
        remote_url="${forwarded_command[$((command_index + 1))]}"
      fi
      ;;
    --remote=*) remote_url="${forwarded_command[$command_index]#--remote=}" ;;
  esac
done

launch_kind="new"
[[ -z "$thread_id" ]] || launch_kind="resume"
agent_threads_launch_log codex-terminal-open request \
  "kind=$launch_kind" "thread_id=${thread_id:-none}" \
  "terminal_cwd=$terminal_cwd" "requested_terminal_cwd=$requested_terminal_cwd" \
  "mapping_namespace=${mapping_namespace:-none}" \
  "remote=$([[ -n "$remote_url" ]] && printf yes || printf no)" \
  "command=${forwarded_command[*]}"

cleanup_launch_status() {
  [[ -z "$launch_status_file" ]] || rm -f -- "$launch_status_file"
  [[ -z "$launch_status_dir" ]] || rmdir -- "$launch_status_dir" 2>/dev/null || true
}

trap 'launch_status=$?; agent_threads_launch_log codex-terminal-open unexpected-error "exit_status=${launch_status}" "line=${LINENO}" "command=${BASH_COMMAND}"; echo "The Codex terminal adapter failed unexpectedly at line ${LINENO}; see $(agent_threads_launch_log_path)" >&2' ERR
trap 'launch_status=$?; cleanup_launch_status; if (( launch_status != 0 )); then agent_threads_launch_log codex-terminal-open failed "exit_status=${launch_status}"; fi' EXIT

agent_threads_runtime_state_init
proc_root="${CODEX_PROC_ROOT:-/proc}"

source "${script_dir}/lib/codex-terminal-client-lookup.sh"

if existing_address="$(find_existing_client)"; then
  agent_threads_launch_log codex-terminal-open existing-window \
    "address=$existing_address" "source=process"
  focus_client "$existing_address"
  printf '%s\n' "$existing_address"
  exit 0
fi

if detached_tmux_target="$(find_detached_tmux_target)"; then
  IFS='|' read -r detached_tmux_session detached_tmux_window detached_tmux_pane \
    <<<"$detached_tmux_target"
  forwarded_command=(
    tmux select-window -t "$detached_tmux_window" ';'
    select-pane -t "$detached_tmux_pane" ';'
    attach-session -t "=${detached_tmux_session}"
  )
  agent_threads_launch_log codex-terminal-open tmux-attach \
    "session=$detached_tmux_session" "window=$detached_tmux_window" \
    "pane=$detached_tmux_pane"
fi

wait_for_codex_bootstrap() {
  local poll

  bootstrap_exit_status=""
  for (( poll = 0; poll < 20; poll++ )); do
    if [[ -s "$launch_status_file" ]]; then
      bootstrap_exit_status="$(<"$launch_status_file")"
      [[ "$bootstrap_exit_status" =~ ^[0-9]+$ ]] || bootstrap_exit_status="unknown"
      agent_threads_launch_log codex-terminal-open bootstrap-exit \
        "exit_status=$bootstrap_exit_status"
      return 1
    fi
    sleep 0.1
  done
  return 0
}

launch_workspace=""
if [[ "$move_to_active_workspace" == true ]]; then
  launch_workspace="$(hyprctl -j activeworkspace 2>/dev/null \
    | jq -r '.id // empty')"
fi
before_addresses="$(hyprctl -j clients 2>/dev/null | jq -r '.[].address')"
launch_status_dir="$(mktemp -d "${AGENT_THREADS_STATE_DIR}/launch-status.XXXXXX")"
launch_status_file="${launch_status_dir}/command.status"
agent_threads_launch_log codex-terminal-open terminal-launch \
  "workspace=${launch_workspace:-unchanged}"
setsid uwsm-app -- xdg-terminal-exec --dir="$terminal_cwd" \
  bash -lc 'status_file=$1; project=$2; shift 2; cd -- "$project"; agent_status=$?; if (( agent_status == 0 )); then "$@"; agent_status=$?; fi; printf '\''%s\n'\'' "$agent_status" >"$status_file" 2>/dev/null || true; if [[ -n "${AGENT_THREADS_LAUNCH_LOG_PATH:-}" ]]; then printf '\''%(%Y-%m-%dT%H:%M:%S%z)T component=%q phase=%q exit_status=%q cwd=%q\n'\'' -1 codex-terminal-open command-exit "$agent_status" "$project" >>"$AGENT_THREADS_LAUNCH_LOG_PATH" 2>/dev/null || true; fi; exit "$agent_status"' \
  _ "$launch_status_file" "$terminal_cwd" "${forwarded_command[@]}" \
  >>"${AGENT_THREADS_LAUNCH_LOG_PATH:-/dev/null}" 2>&1 &
launcher_pid=$!

for _ in $(seq 1 80); do
  new_address="$(hyprctl -j clients 2>/dev/null | jq -r --arg before "$before_addresses" '
    .[] | .address as $address
    | select((($before | split("\n")) | index($address)) == null)
    | $address' | head -n 1)"
  if [[ -n "$new_address" ]]; then
    move_client_to_launch_workspace "$new_address"
    focus_client "$new_address"
    if ! wait_for_codex_bootstrap; then
      echo "Codex exited during terminal startup with status ${bootstrap_exit_status}; see $(agent_threads_launch_log_path)" >&2
      exit 1
    fi
    agent_threads_launch_log codex-terminal-open window-mapped \
      "address=$new_address" "launcher_pid=$launcher_pid"
    printf '%s\n' "$new_address"
    exit 0
  fi
  sleep 0.1
done

# A terminal may reuse an existing process/window, producing no new address.
if existing_address="$(find_existing_client)"; then
  agent_threads_launch_log codex-terminal-open existing-window \
    "address=$existing_address" "source=final-process-check"
  focus_client "$existing_address"
  printf '%s\n' "$existing_address"
  exit 0
fi

if kill -0 "$launcher_pid" 2>/dev/null; then
  launcher_status="running"
else
  set +e
  wait "$launcher_pid"
  launcher_status="$?"
  set -e
fi
agent_threads_launch_log codex-terminal-open window-timeout \
  "launcher_pid=$launcher_pid" "launcher_status=$launcher_status"
echo "The Codex terminal could not be identified; see $(agent_threads_launch_log_path)" >&2
exit 1

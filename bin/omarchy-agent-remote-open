#!/usr/bin/env bash
# Purpose: Implements the agent remote open command-line entry point.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${script_dir}/lib/agent-terminal-client-lookup.sh"

config_file=""
host_id=""
remote_cwd=""
thread_id=""
selected_model=""
selected_effort=""
selected_agent=""
selected_service_tier=""

# Detached QML instances can retain the pre-refactor positional call until the
# in-process graph reload completes. Translate it once into the named interface.
if (( $# > 0 )) && [[ "$1" != --* ]]; then
  legacy_config="${1:-}"
  legacy_host_id="${2:-}"
  legacy_cwd="${3:-}"
  legacy_thread_id="${4:-}"
  legacy_model="${5:-}"
  legacy_effort="${6:-}"
  legacy_agent="${7:-}"
  legacy_service_tier="${8:-}"
  legacy_named=(--config "$legacy_config" --host-id "$legacy_host_id" --cwd "$legacy_cwd")
  [[ -z "$legacy_thread_id" ]] || legacy_named+=(--thread-id "$legacy_thread_id")
  [[ -z "$legacy_model" ]] || legacy_named+=(--model "$legacy_model")
  [[ -z "$legacy_effort" ]] || legacy_named+=(--effort "$legacy_effort")
  [[ -z "$legacy_agent" ]] || legacy_named+=(--agent "$legacy_agent")
  [[ -z "$legacy_service_tier" ]] \
    || legacy_named+=(--service-tier "$legacy_service_tier")
  set -- "${legacy_named[@]}"
fi

remote_usage() {
  cat <<'EOF'
Usage: omarchy-agent-remote-open --config FILE --host-id ID --cwd DIR [OPTIONS]

Options:
  --thread-id ID
  --model MODEL
  --effort EFFORT
  --agent AGENT
  --service-tier TIER
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --config|--host-id|--cwd|--thread-id|--model|--effort|--agent|--service-tier)
      (( $# >= 2 )) || { echo "Missing value for $1" >&2; exit 2; }
      option="$1"
      value="$2"
      shift 2
      case "$option" in
        --config) config_file="$value" ;;
        --host-id) host_id="$value" ;;
        --cwd) remote_cwd="$value" ;;
        --thread-id) thread_id="$value" ;;
        --model) selected_model="$value" ;;
        --effort) selected_effort="$value" ;;
        --agent) selected_agent="$value" ;;
        --service-tier) selected_service_tier="$value" ;;
      esac
      ;;
    -h|--help)
      remote_usage
      exit 0
      ;;
    *)
      echo "Unknown remote launch option: $1" >&2
      exit 2
      ;;
  esac
done

[[ -n "$config_file" && -n "$host_id" && -n "$remote_cwd" ]] || {
  echo "Invalid remote agent launch arguments" >&2
  exit 2
}
[[ "$host_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || {
  echo "Invalid remote host id" >&2
  exit 2
}
remote_json="$("${script_dir}/omarchy-agent-remote-config" entry \
  "$config_file" "$host_id")" || {
  echo "Remote agent entry not found" >&2
  exit 2
}
provider_type="$(jq -r 'if .providerType == "claude" then "claude" elif .providerType == "opencode" then "opencode" else "codex" end' \
  <<<"$remote_json")"
remote_type="$(jq -r '.type // "app-server"' <<<"$remote_json")"
if [[ -n "$thread_id" && ! "$thread_id" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid remote session id" >&2
  exit 2
fi
if (( ${#selected_model} > 256 )) || [[ "$selected_model" == *$'\n'* \
    || "$selected_model" == *$'\r'* || "$selected_model" == *$'\t'* ]]; then
  echo "Invalid remote model" >&2
  exit 2
fi
if [[ "$provider_type" == "opencode" || "$provider_type" == "codex" ]]; then
  if (( ${#selected_effort} > 256 )) || [[ "$selected_effort" == *$'\n'* \
      || "$selected_effort" == *$'\r'* || "$selected_effort" == *$'\t'* ]]; then
    echo "Invalid remote ${provider_type} effort" >&2
    exit 2
  fi
elif [[ -n "$selected_effort" \
    && ! "$selected_effort" =~ ^(low|medium|high|xhigh|max|auto)$ ]]; then
  echo "Invalid remote effort" >&2
  exit 2
fi
if (( ${#selected_agent} > 256 )) || [[ "$selected_agent" == *$'\n'* \
    || "$selected_agent" == *$'\r'* || "$selected_agent" == *$'\t'* ]]; then
  echo "Invalid remote agent name" >&2
  exit 2
fi
if [[ -n "$selected_service_tier" && ! "$selected_service_tier" =~ ^(default|fast)$ ]]; then
  echo "Invalid remote Codex service tier" >&2
  exit 2
fi

if [[ "$remote_type" != "ssh" ]]; then
  [[ "$provider_type" == "codex" ]] || {
    echo "This remote agent provider requires SSH" >&2
    exit 2
  }
  remote_url="$(jq -r '.url // ""' <<<"$remote_json")"
  token_env="$(jq -r '.authTokenEnv // ""' <<<"$remote_json")"
  token_file="$(jq -r '.authTokenFile // ""' <<<"$remote_json")"
  helper_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -n "$token_file" ]]; then
    if [[ "$token_file" == "~/"* ]]; then
      token_file="${HOME}/${token_file#~/}"
    fi
    [[ -n "$token_env" ]] || token_env="CODEX_REMOTE_TOKEN"
    [[ "$token_env" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
      echo "Invalid Codex remote token environment variable" >&2
      exit 2
    }
    remote_token="$("${script_dir}/omarchy-agent-bounded-file" read \
      "$token_file" 65536)" || exit 2
    export "${token_env}=${remote_token}"
  fi

  terminal_command=("${helper_dir}/omarchy-codex-terminal-open"
    --terminal-cwd "${HOME}")
  if [[ -n "$thread_id" ]]; then
    terminal_command+=(--thread-id "$thread_id")
  else
    terminal_command+=(--move-to-active-workspace)
  fi
  codex_command=(codex --remote "$remote_url")
  [[ -z "$token_env" ]] || codex_command+=(--remote-auth-token-env "$token_env")
  [[ -z "$selected_model" ]] || codex_command+=(--model "$selected_model")
  [[ -z "$selected_effort" ]] \
    || codex_command+=(-c "model_reasoning_effort=\"${selected_effort}\"")
  [[ -z "$selected_service_tier" ]] \
    || codex_command+=(-c "service_tier=\"${selected_service_tier}\"")
  codex_command+=(-C "$remote_cwd")
  [[ -z "$thread_id" ]] || codex_command+=(resume "$thread_id")
  exec "${terminal_command[@]}" -- "${codex_command[@]}"
fi

ssh_host="$(jq -r '.sshHost // ""' <<<"$remote_json")"
[[ "$ssh_host" =~ ^[A-Za-z0-9_.@:-]+$ ]] || {
  echo "Invalid SSH host or alias" >&2
  exit 2
}
focus_client() {
  local address="$1"
  hyprctl dispatch "hl.dsp.focus({ window = \"address:${address}\" })" >/dev/null
}

if [[ -n "$thread_id" ]]; then
  agent_lookup_kind="ssh-${provider_type}"
  agent_lookup_session_id="$thread_id"
  agent_lookup_ssh_host="$ssh_host"
  if existing_client="$(find_existing_agent_client)"; then
    IFS=$'\t' read -r mapped_address _ <<< "$existing_client"
    focus_client "$mapped_address"
    jq -cn --arg address "$mapped_address" --arg sessionId "$thread_id" \
      '{address:$address,sessionId:$sessionId}'
    exit 0
  fi
fi

source "${script_dir}/lib/remote-agent-command.sh"

before_addresses="$(hyprctl -j clients 2>/dev/null | jq -r '.[].address')"
omarchy launch terminal ssh -t -o BatchMode=yes -o ConnectTimeout=8 \
  "$ssh_host" "$remote_command" >/dev/null 2>&1 &

for _ in $(seq 1 80); do
  new_address="$(hyprctl -j clients 2>/dev/null | jq -r --arg before "$before_addresses" '
    .[] | .address as $address
    | select((($before | split("\n")) | index($address)) == null)
    | $address' | head -n 1)"
  if [[ -n "$new_address" ]]; then
    focus_client "$new_address"
    mapped_session_id="${thread_id:-$new_session_id}"
    jq -cn --arg address "$new_address" --arg sessionId "$mapped_session_id" \
      '{address:$address,sessionId:$sessionId}'
    exit 0
  fi
  sleep 0.1
done

echo "The remote agent terminal started, but its Hyprland window could not be identified" >&2
exit 1

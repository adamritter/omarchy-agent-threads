#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${script_dir}/lib/runtime-state.sh"

config_file="${1:-}"
host_id="${2:-}"

[[ -n "$config_file" && -n "$host_id" ]] || {
  echo "Invalid remote Claude login arguments" >&2
  exit 2
}

remote_json="$("${script_dir}/omarchy-agent-remote-config" entry \
  "$config_file" "$host_id")" || {
  echo "Remote entry not found" >&2
  exit 2
}

[[ "$(jq -r '.providerType // ""' <<<"$remote_json")" == "claude" \
    && "$(jq -r '.type // "ssh"' <<<"$remote_json")" == "ssh" ]] || {
  echo "Claude sign-in is only available for an SSH Claude remote" >&2
  exit 2
}

ssh_host="$(jq -r '.sshHost // ""' <<<"$remote_json")"
[[ "$ssh_host" =~ ^[A-Za-z0-9_.@:-]+$ ]] || {
  echo "Invalid SSH host or alias" >&2
  exit 2
}

claude_command="$(jq -r '.claudeCommand // "claude"' <<<"$remote_json")"
[[ "$claude_command" =~ ^[A-Za-z0-9_./-]+$ ]] || {
  echo "Invalid remote Claude command" >&2
  exit 2
}

open_login_url() {
  local url
  "${script_dir}/omarchy-agent-auth-url-watcher" | while IFS= read -r url; do
    omarchy launch browser "$url" >/dev/null 2>&1
  done
}

printf -v quoted_claude_command '%q' "$claude_command"
remote_command="export PATH=\"\$HOME/.local/bin:\$HOME/.claude/local:\$PATH\"; ${quoted_claude_command} auth login; status=\$?; rm -f -- \"\${XDG_STATE_HOME:-\$HOME/.local/state}/omarchy/claude-runtime.json\"; exit \$status"

agent_threads_runtime_root_init
session_dir="$(mktemp -d -p "$AGENT_THREADS_RUNTIME_ROOT" claude-remote-auth-XXXXXX)"
url_pipe="${session_dir}/url.pipe"
mkfifo -m 600 "$url_pipe"
open_login_url < "$url_pipe" &
url_watcher_pid=$!

cleanup() {
  kill "$url_watcher_pid" >/dev/null 2>&1 || true
  wait "$url_watcher_pid" 2>/dev/null || true
  rm -f -- "$url_pipe"
  rmdir -- "$session_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

set +e
ssh -tt -o BatchMode=yes -o ConnectTimeout=8 \
  "$ssh_host" "$remote_command" 2>&1 | tee "$url_pipe"
status="${PIPESTATUS[0]}"
wait "$url_watcher_pid" || true
set -e
exit "$status"

#!/usr/bin/env bash

set -euo pipefail

thread_id="${1:-}"
window_address="${2:-}"
mapping_namespace="${3:-}"
server_url="${4:-}"

if [[ ! "$thread_id" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid Codex thread id" >&2
  exit 2
fi

if [[ ! "$window_address" =~ ^0x[0-9a-fA-F]+$ ]]; then
  echo "Invalid Hyprland window address" >&2
  exit 2
fi
if [[ -n "$mapping_namespace" && ! "$mapping_namespace" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid Codex mapping namespace" >&2
  exit 2
fi
if [[ -n "$server_url" && ! "$server_url" =~ ^http://(127\.0\.0\.1|localhost):[0-9]+$ ]]; then
  echo "Invalid local provider server URL" >&2
  exit 2
fi

if ! hyprctl -j clients 2>/dev/null \
    | jq -e --arg address "$window_address" '.[] | select(.address == $address)' >/dev/null; then
  echo "Codex terminal window no longer exists" >&2
  exit 1
fi

runtime_root="${XDG_RUNTIME_DIR:-/tmp}"
state_dir="${runtime_root}/omarchy-codex-threads-${UID}"
mkdir -p -m 700 "$state_dir"
mapping_prefix="${mapping_namespace:+${mapping_namespace}--}"
printf '%s\n' "$window_address" > "${state_dir}/${mapping_prefix}${thread_id}.address"
if [[ -n "$server_url" ]]; then
  printf '%s\n' "$server_url" > "${state_dir}/${mapping_prefix}${thread_id}.server"
fi

#!/usr/bin/env bash

set -euo pipefail

config_file="${1:-}"
host_id="${2:-}"

[[ -r "$config_file" && -n "$host_id" ]] || {
  echo "Invalid remote Claude install arguments" >&2
  exit 2
}

remote_json="$(jq -cer --arg id "$host_id" \
  '.remotes[] | select(.id == $id)' "$config_file")" || {
  echo "Remote entry not found" >&2
  exit 2
}

[[ "$(jq -r '.providerType // ""' <<<"$remote_json")" == "claude" \
    && "$(jq -r '.type // "ssh"' <<<"$remote_json")" == "ssh" ]] || {
  echo "Claude can only be installed on an SSH Claude remote" >&2
  exit 2
}

ssh_host="$(jq -r '.sshHost // ""' <<<"$remote_json")"
[[ "$ssh_host" =~ ^[A-Za-z0-9_.@:-]+$ ]] || {
  echo "Invalid SSH host or alias" >&2
  exit 2
}

ssh -T -o BatchMode=yes -o ConnectTimeout=8 "$ssh_host" bash -s <<'REMOTE_INSTALL'
set -euo pipefail

if ! command -v curl >/dev/null 2>&1; then
  echo "Installing Claude requires curl on the remote machine" >&2
  exit 1
fi

curl -fsSL https://claude.ai/install.sh | bash

claude_path="$(command -v claude || true)"
if [[ -z "$claude_path" && -x "$HOME/.local/bin/claude" ]]; then
  claude_path="$HOME/.local/bin/claude"
fi
if [[ -z "$claude_path" ]]; then
  echo "The installer completed, but the Claude binary was not found" >&2
  exit 1
fi

"$claude_path" --version
REMOTE_INSTALL

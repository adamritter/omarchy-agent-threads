#!/usr/bin/env node

import fs from "node:fs"
import os from "node:os"

const [remoteUrl = "", tokenEnv = "", configuredTokenFile = ""] = process.argv.slice(2)
const lineLimit = 16 * 1024 * 1024
const tokenFileLimit = 64 * 1024
const pendingMessageLimit = 256
const inboundMessageLimit = 256
const inboundByteLimit = 16 * 1024 * 1024

function fail(message) {
  process.stderr.write(`Codex remote transport: ${message}\n`)
  process.exit(2)
}

function expandHome(path) {
  return path === "~" ? os.homedir()
    : path.startsWith("~/") ? os.homedir() + path.slice(1)
      : path
}

function readBoundedFile(path, limit, label) {
  const descriptor = fs.openSync(path, "r")
  try {
    const buffer = Buffer.allocUnsafe(limit + 1)
    const bytes = fs.readSync(descriptor, buffer, 0, buffer.length, 0)
    if (bytes > limit) throw new Error(`${label} exceeded the 64 KiB limit`)
    return buffer.subarray(0, bytes).toString("utf8")
  } finally {
    fs.closeSync(descriptor)
  }
}

let endpoint
try {
  endpoint = new URL(remoteUrl)
} catch {
  fail("invalid WebSocket URL")
}

if (endpoint.protocol !== "ws:" && endpoint.protocol !== "wss:")
  fail("the sidebar transport requires a ws:// or wss:// URL")

let token = tokenEnv === "" ? "" : String(process.env[tokenEnv] || "").trim()
if (token === "" && configuredTokenFile !== "") {
  try {
    token = readBoundedFile(
      expandHome(configuredTokenFile), tokenFileLimit, "token file").trim()
  } catch (error) {
    fail(`could not read token file: ${error.message}`)
  }
}

if (tokenEnv !== "" && token === "" && configuredTokenFile === "")
  fail(`environment variable ${tokenEnv} is empty`)

const localHosts = new Set(["localhost", "127.0.0.1", "::1", "[::1]"])
if (token !== "" && endpoint.protocol === "ws:" && !localHosts.has(endpoint.hostname))
  fail("refusing to send a bearer token over non-local ws://; use wss://")

const options = token === "" ? {} : {
  headers: { Authorization: `Bearer ${token}` }
}
const socket = new WebSocket(endpoint, options)
const pending = []
let pendingBytes = 0
const inbound = []
let inboundBytes = 0
let deliveringInbound = false
let closing = false
let inputChunks = []
let inputBytes = 0

function sendOrQueue(line) {
  if (line.trim() === "") return
  const bytes = Buffer.byteLength(line)
  if (socket.readyState === WebSocket.OPEN) {
    if (socket.bufferedAmount + bytes > lineLimit)
      fail("outbound request queue exceeded the 16 MiB limit")
    socket.send(line)
  } else if (socket.readyState === WebSocket.CONNECTING) {
    if (pending.length >= pendingMessageLimit || pendingBytes + bytes > lineLimit)
      fail("pre-connect request queue exceeded the 16 MiB limit")
    pending.push({ line, bytes })
    pendingBytes += bytes
  }
}

function appendInput(segment) {
  if (segment.length === 0) return
  if (inputBytes + segment.length > lineLimit)
    fail("request line exceeded the 16 MiB limit")
  inputChunks.push(segment)
  inputBytes += segment.length
}

process.stdin.on("data", chunk => {
  const data = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)
  let start = 0
  for (let index = 0; index < data.length; index++) {
    if (data[index] !== 0x0a) continue
    appendInput(data.subarray(start, index))
    if (inputBytes > 0)
      sendOrQueue(Buffer.concat(inputChunks, inputBytes).toString("utf8"))
    inputChunks = []
    inputBytes = 0
    start = index + 1
  }
  appendInput(data.subarray(start))
})

process.stdin.on("end", () => {
  if (inputBytes > 0)
    sendOrQueue(Buffer.concat(inputChunks, inputBytes).toString("utf8"))
  inputChunks = []
  inputBytes = 0
  closing = true
  if (socket.readyState === WebSocket.OPEN || socket.readyState === WebSocket.CONNECTING)
    socket.close(1000, "stdin closed")
})

socket.onopen = () => {
  while (pending.length > 0) {
    const next = pending.shift()
    pendingBytes -= next.bytes
    if (socket.bufferedAmount + next.bytes > lineLimit)
      fail("outbound request queue exceeded the 16 MiB limit")
    socket.send(next.line)
  }
}

function waitForStdoutDrain() {
  return new Promise((resolve, reject) => {
    const drained = () => {
      process.stdout.off("error", failed)
      resolve()
    }
    const failed = error => {
      process.stdout.off("drain", drained)
      reject(error)
    }
    process.stdout.once("drain", drained)
    process.stdout.once("error", failed)
  })
}

async function deliverInbound() {
  if (deliveringInbound) return
  deliveringInbound = true
  try {
    while (inbound.length > 0 && !closing) {
      const next = inbound[0]
      let message = next.data
      next.data = null
      if (message instanceof Blob) message = await message.text()
      else if (message instanceof ArrayBuffer) message = Buffer.from(message).toString("utf8")
      if (!process.stdout.write(String(message) + "\n")) await waitForStdoutDrain()
      inbound.shift()
      inboundBytes -= next.bytes
    }
  } catch (error) {
    fail(`could not forward response: ${String(error && error.message || error)}`)
  } finally {
    deliveringInbound = false
  }
}

socket.onmessage = event => {
  const message = event.data
  const bytes = typeof message === "string" ? Buffer.byteLength(message)
    : message instanceof Blob ? message.size
      : message instanceof ArrayBuffer ? message.byteLength : lineLimit + 1
  if (bytes > lineLimit) fail("response message exceeded the 16 MiB limit")
  if (inbound.length >= inboundMessageLimit || inboundBytes + bytes > inboundByteLimit)
    fail("inbound response queue exceeded the 16 MiB limit")
  inbound.push({ data: message, bytes })
  inboundBytes += bytes
  void deliverInbound()
}

socket.onerror = event => {
  const detail = event && event.error && event.error.message
    ? `: ${event.error.message}` : ""
  process.stderr.write(`Codex remote transport: WebSocket error${detail}\n`)
}

socket.onclose = event => {
  if (!closing) {
    const reason = event.reason ? ` (${event.reason})` : ""
    process.stderr.write(`Codex remote transport: connection closed ${event.code}${reason}\n`)
    process.exitCode = 1
  }
}

process.on("SIGTERM", () => {
  closing = true
  if (socket.readyState === WebSocket.OPEN) socket.close(1000, "terminated")
  setTimeout(() => process.exit(0), 100)
})

#!/bin/bash

set -euo pipefail

project_cwd="${1:-}"
remote_url="${2:-}"
remote_auth_env="${3:-}"
remote_auth_file="${4:-}"
selected_model="${5:-}"
selected_effort="${6:-}"

if [[ -z "$project_cwd" || ( -z "$remote_url" && ! -d "$project_cwd" ) ]]; then
  echo "Invalid Codex project directory" >&2
  exit 2
fi
if [[ -n "$selected_model" && ! "$selected_model" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid Codex model" >&2
  exit 2
fi
if [[ -n "$selected_effort" && ! "$selected_effort" =~ ^(none|minimal|low|medium|high|xhigh|max)$ ]]; then
  echo "Invalid Codex reasoning effort" >&2
  exit 2
fi

prepare_remote_auth() {
  [[ -n "$remote_auth_file" ]] || return 0
  if [[ "$remote_auth_file" == "~/"* ]]; then
    remote_auth_file="${HOME}/${remote_auth_file#~/}"
  fi
  [[ -r "$remote_auth_file" ]] || {
    echo "Codex remote token file is not readable" >&2
    exit 2
  }
  [[ -n "$remote_auth_env" ]] || remote_auth_env="CODEX_REMOTE_TOKEN"
  [[ "$remote_auth_env" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
    echo "Invalid Codex remote token environment variable" >&2
    exit 2
  }
  remote_token="$(<"$remote_auth_file")"
  export "${remote_auth_env}=${remote_token}"
}

codex_command=(codex)
if [[ -n "$remote_url" ]]; then
  prepare_remote_auth
  codex_command+=(--remote "$remote_url")
  [[ -z "$remote_auth_env" ]] || codex_command+=(--remote-auth-token-env "$remote_auth_env")
fi
[[ -z "$selected_model" ]] || codex_command+=(--model "$selected_model")
[[ -z "$selected_effort" ]] \
  || codex_command+=(-c "model_reasoning_effort=\"${selected_effort}\"")
codex_command+=(-C "$project_cwd")

focus_client() {
  local address="$1"
  hyprctl dispatch "hl.dsp.focus({ window = \"address:${address}\" })" >/dev/null
}

move_client_to_launch_workspace() {
  local address="$1"

  [[ "$launch_workspace" =~ ^[0-9]+$ ]] || return 0
  hyprctl dispatch movetoworkspacesilent \
    "${launch_workspace},address:${address}" >/dev/null
}

launch_workspace="$(hyprctl -j activeworkspace 2>/dev/null \
  | jq -r '.id // empty')"
before_addresses="$(hyprctl -j clients 2>/dev/null | jq -r '.[].address')"
omarchy launch terminal "${codex_command[@]}" >/dev/null 2>&1 &

for _ in $(seq 1 80); do
  new_address="$(hyprctl -j clients 2>/dev/null | jq -r --arg before "$before_addresses" '
    .[] | .address as $address
    | select((($before | split("\n")) | index($address)) == null)
    | $address' | head -n 1)"
  if [[ -n "$new_address" ]]; then
    move_client_to_launch_workspace "$new_address"
    focus_client "$new_address"
    printf '%s\n' "$new_address"
    exit 0
  fi
  sleep 0.1
done

echo "The new Codex terminal started, but its Hyprland window could not be identified" >&2
exit 1

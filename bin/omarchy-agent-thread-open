#!/usr/bin/env bash
# Purpose: Implements the agent thread open command-line entry point.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${script_dir}/lib/agent-terminal-client-lookup.sh"

provider="${1:-}"
session_cwd="${2:-${HOME}}"
session_id="${3:-}"
server_url="${4:-http://127.0.0.1:43962}"
selected_model="${5:-}"
selected_effort="${6:-}"
selected_agent="${7:-}"
new_session_id=""
provider_server_url="$server_url"

[[ "$provider" == "claude" || "$provider" == "opencode" ]] || {
  echo "Unsupported agent provider" >&2
  exit 2
}
if [[ -n "$session_id" && ! "$session_id" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid agent session id" >&2
  exit 2
fi
[[ -d "$session_cwd" ]] || session_cwd="${HOME}"

client_exists() {
  local address="$1"
  hyprctl -j clients 2>/dev/null \
    | jq -e --arg address "$address" '.[] | select(.address == $address)' >/dev/null
}

focus_client() {
  local address="$1"
  hyprctl dispatch "hl.dsp.focus({ window = \"address:${address}\" })" >/dev/null
}

move_client_to_launch_workspace() {
  local address="$1"

  [[ "$launch_workspace" =~ ^[0-9]+$ ]] || return 0
  hyprctl dispatch movetoworkspacesilent \
    "${launch_workspace},address:${address}" >/dev/null
}

if [[ -n "$session_id" ]]; then
  agent_lookup_kind="local-${provider}"
  agent_lookup_session_id="$session_id"
  if existing_client="$(find_existing_agent_client)"; then
    IFS=$'\t' read -r mapped_address mapped_server <<< "$existing_client"
    if [[ -n "$mapped_address" ]] && client_exists "$mapped_address"; then
      focus_client "$mapped_address"
      jq -cn --arg address "$mapped_address" --arg serverUrl "$mapped_server" \
        --arg sessionId "$session_id" \
        '{address:$address,serverUrl:$serverUrl,sessionId:$sessionId}'
      exit 0
    fi
  fi
fi

if [[ "$provider" == "claude" ]]; then
  agent_command=(claude)
  if [[ -n "$session_id" ]]; then
    agent_command+=(--resume "$session_id")
  else
    IFS= read -r new_session_id < /proc/sys/kernel/random/uuid
    agent_command+=(--session-id "$new_session_id")
  fi
  [[ -z "$selected_model" ]] || agent_command+=(--model "$selected_model")
  [[ -z "$selected_effort" ]] || agent_command+=(--effort "$selected_effort")
  [[ -z "$selected_agent" ]] || agent_command+=(--agent "$selected_agent")
  helper_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  hook_command="${helper_dir}/omarchy-claude-thread-hook"
  hook_settings="$(jq -cn --arg command "$hook_command" '{statusLine:{
    type:"command",command:$command,refreshInterval:60
  },hooks:{
    SessionStart:[{matcher:"",hooks:[{type:"command",command:$command}]}],
    UserPromptSubmit:[{matcher:"",hooks:[{type:"command",command:$command}]}],
    Notification:[{matcher:"",hooks:[{type:"command",command:$command}]}],
    Stop:[{matcher:"",hooks:[{type:"command",command:$command}]}],
    StopFailure:[{matcher:"",hooks:[{type:"command",command:$command}]}],
    SessionEnd:[{matcher:"",hooks:[{type:"command",command:$command}]}]
  }}')"
  agent_command+=(--settings "$hook_settings")
else
  if [[ ! "$server_url" =~ ^http://(127\.0\.0\.1|localhost):([0-9]{1,5})$ ]] \
      || (( BASH_REMATCH[2] < 1 || BASH_REMATCH[2] > 65535 )); then
    echo "Invalid local OpenCode server URL" >&2
    exit 2
  fi
  auth_file="${OMARCHY_OPENCODE_AUTH_FILE:-${XDG_STATE_HOME:-${HOME}/.local/state}/omarchy/opencode-server-auth.json}"
  opencode_username="$("${script_dir}/omarchy-agent-bounded-file" json-field \
    "$auth_file" 8192 username)" || exit 2
  opencode_password="$("${script_dir}/omarchy-agent-bounded-file" json-field \
    "$auth_file" 8192 password)" || exit 2
  [[ "$opencode_username" =~ ^[A-Za-z0-9._-]{1,64}$ \
      && "$opencode_password" =~ ^[A-Za-z0-9_-]{32,128}$ ]] || {
    echo "Invalid OpenCode server credentials" >&2
    exit 2
  }
  provider_server_url="$server_url"
  if [[ -z "$session_id" ]]; then
    encoded_cwd="$(jq -rn --arg value "$session_cwd" '$value|@uri')"
    if ! new_session="$(curl -fsS --max-time 5 --max-filesize 1048576 \
        --user "${opencode_username}:${opencode_password}" -X POST \
        "${provider_server_url}/session?directory=${encoded_cwd}" \
        -H 'content-type: application/json' --data '{}')"; then
      echo "OpenCode provider server is unavailable" >&2
      exit 1
    fi
    new_session_id="$(jq -r '.id // empty' <<<"$new_session")"
    [[ "$new_session_id" =~ ^[A-Za-z0-9._-]+$ ]] || {
      echo "OpenCode did not create a valid session" >&2
      exit 1
    }
    session_id="$new_session_id"
  fi
  opencode_port=""
  for _ in $(seq 1 80); do
    candidate_port=$((44000 + RANDOM % 1500))
    if ! ss -Hln "sport = :${candidate_port}" 2>/dev/null | grep -q .; then
      opencode_port="$candidate_port"
      break
    fi
  done
  [[ -n "$opencode_port" ]] || {
    echo "Could not allocate a local OpenCode port" >&2
    exit 1
  }
  server_url="http://127.0.0.1:${opencode_port}"
  agent_command=(env
    "OPENCODE_SERVER_USERNAME=${opencode_username}"
    "OPENCODE_SERVER_PASSWORD=${opencode_password}"
    opencode "$session_cwd" --hostname 127.0.0.1 --port "$opencode_port")
  [[ -z "$selected_model" ]] || agent_command+=(--model "$selected_model")
  [[ -z "$selected_effort" ]] || agent_command+=(--variant "$selected_effort")
  [[ -z "$selected_agent" ]] || agent_command+=(--agent "$selected_agent")
  agent_command+=(--session "$session_id")
fi

launch_workspace="$(hyprctl -j activeworkspace 2>/dev/null \
  | jq -r '.id // empty')"
before_addresses="$(hyprctl -j clients 2>/dev/null | jq -r '.[].address')"
omarchy launch terminal bash -lc 'cd -- "$1" && shift && exec "$@"' \
  _ "$session_cwd" "${agent_command[@]}" >/dev/null 2>&1 &

for _ in $(seq 1 80); do
  new_address="$(hyprctl -j clients 2>/dev/null | jq -r --arg before "$before_addresses" '
    .[] | .address as $address
    | select((($before | split("\n")) | index($address)) == null)
    | $address' | head -n 1)"
  if [[ -n "$new_address" ]]; then
    move_client_to_launch_workspace "$new_address"
    focus_client "$new_address"
    output_server_url=""
    [[ "$provider" != "opencode" ]] || output_server_url="$server_url"
    jq -cn --arg address "$new_address" --arg serverUrl "$output_server_url" \
      --arg sessionId "${new_session_id:-$session_id}" \
      '{address:$address,serverUrl:$serverUrl,sessionId:$sessionId}'
    exit 0
  fi
  sleep 0.1
done

if [[ "$provider" == "opencode" && -n "$new_session_id" ]]; then
  encoded_cwd="$(jq -rn --arg value "$session_cwd" '$value|@uri')"
  curl -fsS --max-time 3 -X DELETE \
    --user "${opencode_username}:${opencode_password}" \
    "${provider_server_url}/session/${new_session_id}?directory=${encoded_cwd}" \
    >/dev/null 2>&1 || true
fi
echo "The agent terminal started, but its Hyprland window could not be identified" >&2
exit 1

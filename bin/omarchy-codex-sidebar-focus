#!/bin/bash

set -u

target="agent-threads"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Resolve the active terminal while it still owns the toplevel focus. A Codex
# process may hold internal subagent rollouts in addition to the visible thread.
active_thread_id="$("${script_dir}/omarchy-codex-active-thread" 2>/dev/null || true)"
cursor_origin="$(hyprctl cursorpos 2>/dev/null || true)"
origin_x=""
origin_y=""
if [[ "$cursor_origin" =~ ^[[:space:]]*(-?[0-9]+)[[:space:]]*,[[:space:]]*(-?[0-9]+)[[:space:]]*$ ]]; then
  origin_x="${BASH_REMATCH[1]}"
  origin_y="${BASH_REMATCH[2]}"
fi

# Open, select the active thread, lay out its row, and return its cursor target
# in one Quickshell IPC turn. If the thread is still loading, the plugin returns
# the visible list center and follows the session when its model arrives.
point="$(
  omarchy-shell "$target" prepareFocus "$active_thread_id" 2>/dev/null || true
)"

# Fullscreen workspaces intentionally suppress the sidebar; do not spend a
# second polling for a layer surface that cannot be mapped there.
if jq -e '.presented == false' >/dev/null 2>&1 <<<"$point"; then
  exit 0
fi

layer=""
for _ in {1..40}; do
  layer="$(hyprctl layers -j 2>/dev/null \
    | jq -c '[.. | objects | select(.namespace? == "omarchy-codex-threads")] | first // empty' \
      2>/dev/null || true)"

  if jq -e '.x | numbers' >/dev/null 2>&1 <<<"$layer" \
      && jq -e '.y | numbers' >/dev/null 2>&1 <<<"$layer" \
      && jq -e '.w | numbers' >/dev/null 2>&1 <<<"$layer" \
      && jq -e '.h | numbers' >/dev/null 2>&1 <<<"$layer"; then
    break
  fi

  sleep 0.025
done

if [[ -n "$layer" ]]; then
  if ! jq -e --argjson layer "$layer" \
      '(.x | numbers) and (.y | numbers)
       and .x >= 1 and .y >= 1 and .x < $layer.w and .y < $layer.h' \
      >/dev/null 2>&1 <<<"$point"; then
    point="$(jq -c '{ x: (.w / 2), y: (.h / 2) }' <<<"$layer")"
  fi

  target_x="$(jq -nr --argjson point "$point" --argjson layer "$layer" \
    '$layer.x + $point.x | round')"
  target_y="$(jq -nr --argjson point "$point" --argjson layer "$layer" \
    '$layer.y + $point.y | round')"

  hyprctl dispatch \
    "hl.dsp.cursor.move({ x = ${target_x}, y = ${target_y} })" >/dev/null 2>&1 || true
fi

# Acquire keyboard focus immediately after the cursor is inside the sidebar;
# this ordering is required when Hyprland input:follow_mouse is enabled.
if [[ -n "$origin_x" && -n "$origin_y" ]]; then
  omarchy-shell -q "$target" focusFrom "$origin_x" "$origin_y" >/dev/null
else
  omarchy-shell -q "$target" focus >/dev/null
fi

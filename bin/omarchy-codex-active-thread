#!/usr/bin/env bash
# Purpose: Implements the Codex active thread command-line entry point.

set -u

proc_root="${OMARCHY_CODEX_PROC_ROOT:-/proc}"
active_json="${OMARCHY_CODEX_ACTIVE_WINDOW_JSON:-}"
if [[ -z "$active_json" ]]; then
  active_json="$(hyprctl -j activewindow 2>/dev/null || true)"
fi
active_address="$(jq -r '.address // empty' <<<"$active_json" 2>/dev/null)"
active_pid="$(jq -r '.pid // empty' <<<"$active_json" 2>/dev/null)"

[[ -n "$active_address" && "$active_pid" =~ ^[0-9]+$ ]] || exit 0

thread_id_from_process() {
  local process_id="$1"
  local fallback_id=""
  local fd_target
  local session_meta
  local thread_id

  [[ -d "${proc_root}/${process_id}/fd" ]] || return 1
  while IFS= read -r fd_target; do
    if [[ "$fd_target" =~ /rollout-.*-([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\.jsonl$ ]]; then
      thread_id="${BASH_REMATCH[1]}"
      [[ -n "$fallback_id" ]] || fallback_id="$thread_id"

      session_meta=""
      [[ -r "$fd_target" ]] && IFS= read -r session_meta < "$fd_target"
      if jq -e '.type == "session_meta"
          and (.payload.source | type) == "object"
          and .payload.source.subagent != null' >/dev/null 2>&1 <<<"$session_meta"; then
        continue
      fi

      printf '%s\n' "$thread_id"
      return 0
    fi
  done < <(find "${proc_root}/${process_id}/fd" -maxdepth 1 -type l -printf '%l\n' 2>/dev/null)

  if [[ -n "$fallback_id" ]]; then
    printf '%s\n' "$fallback_id"
    return 0
  fi

  return 1
}

# Walk only the active window's process subtree using procfs files and shell
# builtins. This avoids pgrep plus a ps/tr chain for every Codex process.
queue=("$active_pid")
queue_index=0
while (( queue_index < ${#queue[@]} )); do
  process_id="${queue[$queue_index]}"
  ((queue_index += 1))

  process_name=""
  [[ -r "${proc_root}/${process_id}/comm" ]] \
    && IFS= read -r process_name < "${proc_root}/${process_id}/comm"
  if [[ "$process_name" == "codex" ]] && thread_id_from_process "$process_id"; then
    exit 0
  fi

  children=""
  if [[ -r "${proc_root}/${process_id}/task/${process_id}/children" ]]; then
    IFS= read -r children < "${proc_root}/${process_id}/task/${process_id}/children" || true
    for child_pid in $children; do
      [[ "$child_pid" =~ ^[0-9]+$ ]] && queue+=("$child_pid")
    done
  fi
done

exit 0

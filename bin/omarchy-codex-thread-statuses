#!/usr/bin/env bash
set -euo pipefail

declare -A live_rollouts=()
declare -A last_events=()
declare -A last_approval_events=()
declare -A last_approval_reviewers=()
declare -a thread_ids=()
declare -a rollout_paths=()
declare -a codex_fd_dirs=()
declare -a live_rollouts_to_scan=()
declare -A client_by_pid=()

while (( $# >= 2 )); do
  thread_ids+=("$1")
  rollout_paths+=("$2")
  shift 2
done

# Resolve all rollout symlinks with one find process. The old implementation
# spawned one readlink process for every FD of every Codex process.
if [[ -n "${OMARCHY_CODEX_LIVE_ROLLOUTS:-}" ]]; then
  while IFS= read -r rollout_path; do
    [[ -n "$rollout_path" ]] || continue
    live_rollouts["$rollout_path"]=1
  done <<< "$OMARCHY_CODEX_LIVE_ROLLOUTS"
else
  while read -r codex_pid; do
    [[ "$codex_pid" =~ ^[0-9]+$ && -d "/proc/${codex_pid}/fd" ]] || continue
    codex_fd_dirs+=("/proc/${codex_pid}/fd")
  done < <(pgrep -x codex 2>/dev/null || true)
fi

if (( ${#codex_fd_dirs[@]} > 0 )); then
  while IFS= read -r rollout_path; do
    [[ "$rollout_path" == */rollout-*.jsonl ]] || continue
    live_rollouts["$rollout_path"]=1
  done < <(find "${codex_fd_dirs[@]}" -maxdepth 1 -type l -printf '%l\n' 2>/dev/null || true)
fi

# Rebuild thread-to-window mappings from the live process tree. This also
# repairs sessions whose rollout was created only after the launch timeout.
while IFS=$'\t' read -r client_address client_pid; do
  [[ -n "$client_address" && "$client_pid" =~ ^[0-9]+$ ]] || continue
  client_by_pid["$client_pid"]="$client_address"
done < <(hyprctl -j clients 2>/dev/null | jq -r '.[] | [.address, .pid] | @tsv' 2>/dev/null || true)

client_address_for_process() {
  local current_pid="$1"
  local parent_pid stat_line stat_tail

  while [[ "$current_pid" =~ ^[0-9]+$ ]] && (( current_pid > 1 )); do
    if [[ -n "${client_by_pid[$current_pid]:-}" ]]; then
      printf '%s\n' "${client_by_pid[$current_pid]}"
      return 0
    fi

    [[ -r "/proc/${current_pid}/stat" ]] || break
    stat_line="$(<"/proc/${current_pid}/stat")"
    stat_tail="${stat_line##*) }"
    read -r _ parent_pid _ <<<"$stat_tail" || true
    [[ "$parent_pid" =~ ^[0-9]+$ ]] || break
    current_pid="$parent_pid"
  done

  return 1
}

runtime_root="${XDG_RUNTIME_DIR:-/tmp}"
state_dir="${runtime_root}/omarchy-codex-threads-${UID}"
mkdir -p -m 700 "$state_dir"

for fd_dir in "${codex_fd_dirs[@]}"; do
  codex_pid="${fd_dir#/proc/}"
  codex_pid="${codex_pid%/fd}"
  [[ "$codex_pid" =~ ^[0-9]+$ ]] || continue

  cmdline="$(tr '\0' ' ' < "/proc/${codex_pid}/cmdline" 2>/dev/null || true)"
  [[ "$cmdline" != *" --remote "* ]] || continue
  client_address="$(client_address_for_process "$codex_pid" || true)"
  [[ -n "$client_address" ]] || continue

  while IFS= read -r rollout_path; do
    if [[ "$rollout_path" =~ -([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\.jsonl$ ]]; then
      printf '%s\n' "$client_address" > "${state_dir}/${BASH_REMATCH[1]}.address"
    fi
  done < <(find "$fd_dir" -maxdepth 1 -type l -printf '%l\n' 2>/dev/null || true)
done

# A closed rollout is necessarily done, so only scan files currently held open
# by Codex. This keeps refresh cost proportional to live sessions instead of
# repeatedly reading the entire visible history.
for rollout_path in "${rollout_paths[@]}"; do
  if [[ "${live_rollouts[$rollout_path]-}" == 1 ]]; then
    live_rollouts_to_scan+=("$rollout_path")
  fi
done

# One rg process scans the live rollouts. Lifecycle and approval events are
# tracked separately so a completed tool call does not hide a running turn.
# Turn contexts identify whether an approval is routed to a person or an
# automatic reviewer.
if (( ${#live_rollouts_to_scan[@]} > 0 )); then
  while IFS= read -r match_line; do
    rollout_path="${match_line%%:*}"
    event="${match_line#*:}"
    if [[ "$event" == '"approvals_reviewer":'* ]]; then
      last_approval_reviewers["$rollout_path"]="$event"
    elif [[ "$event" == *'"custom_tool_call"'* \
        || "$event" == *'"custom_tool_call_output"'* ]]; then
      last_approval_events["$rollout_path"]="$event"
    else
      last_events["$rollout_path"]="$event"
    fi
  done < <(rg --with-filename -o -P \
    '"type":"(task_started|task_complete|turn_aborted|custom_tool_call_output)"|"type":"custom_tool_call"(?=.*\\"sandbox_permissions\\":\\"require_escalated\\")|"approvals_reviewer":"(user|auto_review|guardian_subagent)"' \
    "${live_rollouts_to_scan[@]}" 2>/dev/null || true)
fi

first=true
printf '{'

for (( i = 0; i < ${#thread_ids[@]}; i++ )); do
  thread_id="${thread_ids[$i]}"
  rollout_path="${rollout_paths[$i]}"
  status="done"

  if [[ "${last_events[$rollout_path]-}" == *'"task_started"'* \
      && "${live_rollouts[$rollout_path]-}" == 1 ]]; then
    status="busy"
  fi
  if [[ "${last_approval_events[$rollout_path]-}" == *'"custom_tool_call"'* \
      && "${last_approval_reviewers[$rollout_path]-}" != *'"auto_review"'* \
      && "${last_approval_reviewers[$rollout_path]-}" != *'"guardian_subagent"'* \
      && "${live_rollouts[$rollout_path]-}" == 1 ]]; then
    status="blocked"
  fi

  if [[ "$first" == true ]]; then
    first=false
  else
    printf ','
  fi
  printf '"%s":"%s"' "$thread_id" "$status"
done

printf '}\n'

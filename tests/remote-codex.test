#!/usr/bin/env bash
# Purpose: Exercises the remote Codex workflow across its real process boundary.

set -euo pipefail

test_root="$(mktemp -d -t codex-threads-remote-codex-XXXXXX)"
trap 'rm -rf -- "$test_root"' EXIT
plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
stub_bin="$test_root/bin"
mkdir -p -- "$stub_bin"

cat > "$stub_bin/ssh" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail
case "${REMOTE_QUERY_OUTPUT:-}" in
  oversized-stdout)
    head -c $((17 * 1024 * 1024)) /dev/zero | tr '\0' x
    exit 0
    ;;
  oversized-stderr)
    head -c $((300 * 1024)) /dev/zero | tr '\0' x >&2
    exit 1
    ;;
esac

while IFS= read -r request; do
  id="$(jq -r '.id' <<<"$request")"
  method="$(jq -r '.method' <<<"$request")"
  case "$method" in
    initialize)
      jq -cn --argjson id "$id" '{id:$id,result:{}}'
      ;;
    thread/list)
      if [[ "${REMOTE_QUERY_OUTPUT:-}" == "excess-items" ]]; then
        node -e 'const id=Number(process.argv[1]); console.log(JSON.stringify({id,result:{data:Array.from({length:2001},(_,index)=>({id:`thread-${index}`}))}}))' "$id"
        continue
      fi
      if [[ "${REMOTE_QUERY_OUTPUT:-}" == "aggregate-bytes" ]]; then
        node -e 'const id=Number(process.argv[1]); console.log(JSON.stringify({id,result:{data:[{id:`thread-${id}`,name:"x".repeat(2*1024*1024)}],nextCursor:"again"}}))' "$id"
        continue
      fi
      jq -cn --argjson id "$id" \
        '{id:$id,result:{data:[{id:"remote-thread",cwd:"/work",name:"Remote thread"}]}}'
      ;;
    project/list)
      jq -cn --argjson id "$id" '{id:$id,result:{data:[]}}'
      ;;
  esac
done
EOF
chmod +x "$stub_bin/ssh"

config="$test_root/remotes.json"
jq -n '{version:2,remotes:[{
  id:"remote-codex",label:"Fixture Codex",type:"ssh",providerType:"codex",
  sshHost:"fixture",codexCommand:"codex",home:"/work"
}]}' > "$config"

snapshot="$(PATH="$stub_bin:$PATH" "$plugin_root/bin/omarchy-agent-remote-query" \
  "$config" remote-codex snapshot)"
jq -e '
  .hostId == "remote-codex" and .type == "ssh" and .home == "/work"
  and (.threads[] | select(.id == "remote-thread") | .cwd == "/work")
' <<<"$snapshot" >/dev/null

if PATH="$stub_bin:$PATH" REMOTE_QUERY_OUTPUT=oversized-stdout \
    "$plugin_root/bin/omarchy-agent-remote-query" "$config" remote-codex snapshot \
    >"$test_root/oversized-stdout" 2>"$test_root/oversized-stdout-error"; then
  echo "Remote Codex unexpectedly accepted an oversized SSH response line" >&2
  exit 1
fi
grep -F -- "remote Codex SSH response line exceeded the 16 MiB limit" \
  "$test_root/oversized-stdout-error" >/dev/null

if PATH="$stub_bin:$PATH" REMOTE_QUERY_OUTPUT=oversized-stderr \
    "$plugin_root/bin/omarchy-agent-remote-query" "$config" remote-codex snapshot \
    >"$test_root/oversized-stderr" 2>"$test_root/oversized-stderr-error"; then
  echo "Remote Codex unexpectedly accepted oversized SSH stderr" >&2
  exit 1
fi
grep -F -- "remote Codex SSH stderr exceeded the 256 KiB limit" \
  "$test_root/oversized-stderr-error" >/dev/null

oversized_config="$test_root/oversized-remotes.json"
head -c $((1024 * 1024 + 1)) /dev/zero | tr '\0' x >"$oversized_config"
if "$plugin_root/bin/omarchy-agent-remote-query" \
    "$oversized_config" remote-codex snapshot \
    >"$test_root/config-output" 2>"$test_root/config-error"; then
  echo "Remote Codex unexpectedly accepted an oversized remotes config" >&2
  exit 1
fi
grep -E -- "remotes config.*exceeded.*byte limit" \
  "$test_root/config-error" >/dev/null

token_file="$test_root/oversized-token"
head -c $((65 * 1024)) /dev/zero | tr '\0' t >"$token_file"
app_server_config="$test_root/app-server-remotes.json"
jq -n --arg tokenFile "$token_file" '{version:2,remotes:[{
  id:"remote-app-server",label:"Fixture App Server",type:"app-server",
  providerType:"codex",url:"ws://127.0.0.1:1",authTokenFile:$tokenFile
}]}' >"$app_server_config"
if "$plugin_root/bin/omarchy-agent-remote-query" \
    "$app_server_config" remote-app-server snapshot \
    >"$test_root/token-output" 2>"$test_root/token-error"; then
  echo "Remote Codex unexpectedly accepted an oversized token file" >&2
  exit 1
fi
grep -E -- "token file.*exceeded.*byte limit" \
  "$test_root/token-error" >/dev/null

for special_file in "$test_root/token-link" "$test_root/token-fifo" /dev/zero; do
  if [[ "$special_file" == *token-link ]]; then
    ln -s -- "$token_file" "$special_file"
  elif [[ "$special_file" == *token-fifo ]]; then
    mkfifo "$special_file"
  fi
  jq --arg tokenFile "$special_file" \
    '(.remotes[0].authTokenFile) = $tokenFile' "$app_server_config" \
    > "$test_root/special-remotes.json"
  set +e
  timeout 2 "$plugin_root/bin/omarchy-agent-remote-query" \
    "$test_root/special-remotes.json" remote-app-server snapshot \
    >/dev/null 2>"$test_root/special-error"
  special_status=$?
  set -e
  if (( special_status == 0 || special_status == 124 )); then
    echo "Remote Codex did not safely reject special token file: $special_file" >&2
    exit 1
  fi
done

for attack in excess-items aggregate-bytes; do
  if PATH="$stub_bin:$PATH" REMOTE_QUERY_OUTPUT="$attack" \
      "$plugin_root/bin/omarchy-agent-remote-query" "$config" remote-codex snapshot \
      >/dev/null 2>"$test_root/$attack-error"; then
    echo "Remote Codex unexpectedly accepted $attack" >&2
    exit 1
  fi
done
grep -F -- "thread/list exceeded the 2000 item limit" \
  "$test_root/excess-items-error" >/dev/null
grep -F -- "thread/list exceeded the 32 MiB retained-data limit" \
  "$test_root/aggregate-bytes-error" >/dev/null

printf '%s\n' "remote-codex tests passed"

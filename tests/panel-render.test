#!/usr/bin/env bash

set -euo pipefail

plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
live_wayland="${PANEL_TEST_LIVE_WAYLAND:-0}"

if [[ "$live_wayland" != "1" ]]; then
  panel_source="$plugin_root/Panel.qml"
  list_source="$plugin_root/ui/CodexThreadList.qml"

  [[ "$(grep -c '^[[:space:]]*PanelWindow[[:space:]]*{' "$panel_source")" == "1" ]]
  if grep -q 'id: sidebarReservation' "$panel_source"; then
    printf '%s\n' 'Panel.qml still owns a separate reservation window' >&2
    exit 1
  fi
  grep -q 'id: panel' "$panel_source"
  grep -q 'exclusiveZone: root.sidebarContentWidth' "$panel_source"
  grep -q 'id: threadList' "$panel_source"
  grep -q 'id: helpOverlay' "$panel_source"
  grep -q 'Ui.CodexThreadList' "$panel_source"
  grep -q 'id: searchButton' "$panel_source"
  grep -q 'onClicked: root.startSearch()' "$panel_source"
  grep -q 'JSON.parse(sidebarActions.activeThreadCursorPoint())' "$panel_source"
  grep -q 'pointerHoverSuppressed = true' "$panel_source"
  grep -q 'function nextThread(): string' "$panel_source"
  grep -q 'function previousThread(): string' "$panel_source"
  grep -q 'root.service.flushProviderSnapshot()' "$panel_source"
  grep -q 'id: projectMenu' "$list_source"
  grep -q 'panel.sidebarActions.openSelectedTerminal()' "$list_source"

  "$plugin_root/scripts/test-unit" \
    tests/tst_threadlistmodel.qml \
    tests/tst_sidebarcontroller.qml \
    tests/tst_keycatcher.qml
  printf '%s\n' 'panel-render contract tests passed'
  exit 0
fi

test_root="$(mktemp -d -t agent-threads-panel-render-XXXXXX)"
output_file="$test_root/output.log"
trap 'rm -rf -- "$test_root"' EXIT

ln -s -- /usr/share/omarchy/shell/Commons "$test_root/Commons"
ln -s -- /usr/share/omarchy/shell/Ui "$test_root/Ui"
ln -s -- "$plugin_root" "$test_root/AgentThreads"
cp -- "$plugin_root/tests/panel-harness/shell.qml" "$test_root/shell.qml"

set +e
AGENT_THREADS_PANEL_TEST=1 AGENT_THREADS_PANEL_TEST_LIVE=1 \
  timeout 15s quickshell --path "$test_root/shell.qml" \
  >"$output_file" 2>&1
exit_code=$?
set -e

if (( exit_code != 0 )); then
  cat "$output_file" >&2
  printf 'Panel render harness exited with code %d.\n' "$exit_code" >&2
  exit "$exit_code"
fi

if ! grep -q 'PANEL_RENDER_PASS:' "$output_file"; then
  cat "$output_file" >&2
  printf '%s\n' 'Panel render harness did not report success.' >&2
  exit 1
fi

if grep -q 'PANEL_RENDER_FAIL:' "$output_file"; then
  cat "$output_file" >&2
  exit 1
fi

remaining_layers="$(hyprctl layers -j | jq '[
  .. | objects | .namespace? // empty
  | select(startswith("agent-threads-panel-test"))
] | length')"
if [[ "$remaining_layers" != "0" ]]; then
  cat "$output_file" >&2
  printf 'Panel render harness left %s test layer surfaces behind.\n' \
    "$remaining_layers" >&2
  exit 1
fi

printf '%s\n' 'panel-render tests passed'

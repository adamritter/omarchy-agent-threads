#!/usr/bin/env bash
# Purpose: Verifies panel ownership and wiring, with an opt-in live Wayland smoke mode.

set -euo pipefail

plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
live_wayland="${PANEL_TEST_LIVE_WAYLAND:-0}"
test_root="$(mktemp -d -t agent-threads-panel-render-XXXXXX)"
output_file="$test_root/output.log"
trap 'rm -rf -- "$test_root"' EXIT

ln -s -- /usr/share/omarchy/shell/Commons "$test_root/Commons"
ln -s -- /usr/share/omarchy/shell/Ui "$test_root/Ui"
ln -s -- "$plugin_root" "$test_root/AgentThreads"
cp -- "$plugin_root/tests/panel-harness/shell.qml" \
  "$plugin_root/tests/panel-harness/FakePanelService.qml" \
  "$plugin_root/tests/panel-harness/PanelLayerProbe.qml" \
  "$plugin_root/tests/panel-harness/PanelReloadBoundaryProbe.qml" \
  "$test_root/"

if [[ "$live_wayland" != "1" ]]; then
  set +e
  AGENT_THREADS_PANEL_TEST=1 AGENT_THREADS_PANEL_TEST_COMPILE_ONLY=1 \
    timeout 15s quickshell --path "$test_root/shell.qml" \
    >"$output_file" 2>&1
  exit_code=$?
  set -e

  if (( exit_code != 0 )) \
      || ! grep -q 'PANEL_COMPONENT_PASS:' "$output_file" \
      || grep -q 'PANEL_RENDER_FAIL:' "$output_file" \
      || grep -Eq 'ReferenceError:|Cannot assign \[undefined\]' "$output_file"; then
    cat "$output_file" >&2
    printf 'Panel component-load contract failed with code %d.\n' \
      "$exit_code" >&2
    exit 1
  fi

  "$plugin_root/scripts/test-unit" \
    tests/tst_threadlistmodel.qml \
    tests/tst_sidebarcontroller.qml \
    tests/tst_sidebarnavigation.qml \
    tests/tst_keycatcher.qml \
    tests/tst_panelfocuslogic.qml \
    tests/tst_panelfocuscontroller.qml \
    tests/tst_panelhelplogic.qml \
    tests/tst_panelreloadstatelogic.qml
  printf '%s\n' 'Panel component and behavior contracts passed.'
  exit 0
fi

set +e
AGENT_THREADS_PANEL_TEST=1 AGENT_THREADS_PANEL_TEST_LIVE=1 \
  timeout 15s quickshell --path "$test_root/shell.qml" \
  >"$output_file" 2>&1
exit_code=$?
set -e

if (( exit_code != 0 )); then
  cat "$output_file" >&2
  printf 'Panel render harness exited with code %d.\n' "$exit_code" >&2
  exit "$exit_code"
fi

if ! grep -q 'PANEL_RENDER_PASS:' "$output_file"; then
  cat "$output_file" >&2
  printf '%s\n' 'Panel render harness did not report success.' >&2
  exit 1
fi

if grep -q 'PANEL_RENDER_FAIL:' "$output_file"; then
  cat "$output_file" >&2
  exit 1
fi

remaining_layers="$(hyprctl layers -j | jq '[
  .. | objects | .namespace? // empty
  | select(startswith("agent-threads-panel-test"))
] | length')"
if [[ "$remaining_layers" != "0" ]]; then
  cat "$output_file" >&2
  printf 'Panel render harness left %s test layer surfaces behind.\n' \
    "$remaining_layers" >&2
  exit 1
fi

printf '%s\n' 'Panel live Wayland smoke test passed.'

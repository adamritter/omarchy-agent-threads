#!/usr/bin/env bash

set -euo pipefail

plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d)"
trap 'rm -rf -- "$test_root"' EXIT

busy_id="11111111-1111-1111-1111-111111111111"
blocked_id="22222222-2222-2222-2222-222222222222"
done_id="33333333-3333-3333-3333-333333333333"
working_id="44444444-4444-4444-4444-444444444444"
busy_rollout="$test_root/rollout-test-$busy_id.jsonl"
blocked_rollout="$test_root/rollout-test-$blocked_id.jsonl"
done_rollout="$test_root/rollout-test-$done_id.jsonl"
working_rollout="$test_root/rollout-test-$working_id.jsonl"

printf '%s\n' '{"type":"event_msg","payload":{"type":"task_started"}}' > "$busy_rollout"
printf '%s\n' \
  '{"type":"event_msg","payload":{"type":"task_started"}}' \
  '{"type":"response_item","payload":{"type":"custom_tool_call","name":"exec","input":"{\"sandbox_permissions\":\"require_escalated\"}"}}' \
  > "$blocked_rollout"
printf '%s\n' \
  '{"type":"event_msg","payload":{"type":"task_started"}}' \
  '{"type":"response_item","payload":{"type":"custom_tool_call","name":"exec","input":"{\"sandbox_permissions\":\"require_escalated\"}"}}' \
  '{"type":"response_item","payload":{"type":"custom_tool_call_output"}}' \
  '{"type":"event_msg","payload":{"type":"task_complete"}}' \
  > "$done_rollout"
printf '%s\n' \
  '{"type":"event_msg","payload":{"type":"task_started"}}' \
  '{"type":"response_item","payload":{"type":"custom_tool_call","name":"exec","input":"{\"sandbox_permissions\":\"require_escalated\"}"}}' \
  '{"type":"response_item","payload":{"type":"custom_tool_call_output"}}' \
  > "$working_rollout"

actual="$(
  OMARCHY_CODEX_LIVE_ROLLOUTS="$(printf '%s\n%s\n%s\n%s' \
    "$busy_rollout" "$blocked_rollout" "$done_rollout" "$working_rollout")" \
    "$plugin_dir/bin/omarchy-codex-thread-statuses" \
      "$busy_id" "$busy_rollout" \
      "$blocked_id" "$blocked_rollout" \
      "$done_id" "$done_rollout" \
      "$working_id" "$working_rollout"
)"

expected="{\"$busy_id\":\"busy\",\"$blocked_id\":\"blocked\",\"$done_id\":\"done\",\"$working_id\":\"busy\"}"
if [[ "$actual" != "$expected" ]]; then
  printf 'Expected %s, got %s\n' "$expected" "$actual" >&2
  exit 1
fi

printf 'thread-statuses tests passed\n'

#!/usr/bin/env bash
# Purpose: Exercises the directory picker workflow across its real process boundary.

set -euo pipefail

test_root="$(mktemp -d -t agent-threads-directory-picker-XXXXXX)"
trap 'rm -rf -- "$test_root"' EXIT
plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
helper="$plugin_root/bin/omarchy-agent-directory-picker"

mkdir -p -- "$test_root/alpha" "$test_root/Beta" "$test_root/file-dir"
printf '%s\n' "not a directory" > "$test_root/plain-file"

listing="$($helper local - list "$test_root")"
jq -e --arg path "$test_root" '.path == $path' <<<"$listing" >/dev/null
jq -e '.entries | map(.name) == ["alpha", "Beta", "file-dir"]' <<<"$listing" >/dev/null

large_directory="$test_root/large"
mkdir -p -- "$large_directory"
for index in $(seq 1 2001); do mkdir "$large_directory/entry-$index"; done
large_listing="$($helper local - list "$large_directory")"
jq -e '.truncated == true and (.entries | length) == 2000' \
  <<<"$large_listing" >/dev/null

created="$($helper local - mkdir "$test_root" "new project")"
jq -e --arg path "$test_root/new project" '.path == $path and .entries == []' \
  <<<"$created" >/dev/null
[[ -d "$test_root/new project" ]]

if $helper local - mkdir "$test_root" "../escape" >/dev/null 2>&1; then
  echo "Directory picker unexpectedly accepted a path separator" >&2
  exit 1
fi

if $helper ssh 'bad host!' list / >/dev/null 2>&1; then
  echo "Directory picker unexpectedly accepted an invalid SSH host" >&2
  exit 1
fi

fake_bin="$test_root/bin"
mkdir -p -- "$fake_bin"
cat > "$fake_bin/ssh" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail
cat >/dev/null

case "${FAKE_SSH_OUTPUT:-}" in
  oversized-stdout)
    head -c $((17 * 1024 * 1024)) /dev/zero | tr '\0' x
    ;;
  oversized-stderr)
    head -c $((300 * 1024)) /dev/zero | tr '\0' x >&2
    ;;
  *)
    printf '%s\n' '{"path":"/","parent":"/","home":"/home/test","entries":[],"truncated":false}'
    ;;
esac
EOF
chmod +x "$fake_bin/ssh"

remote_listing="$(PATH="$fake_bin:$PATH" "$helper" ssh test-host list /)"
jq -e '.path == "/" and .home == "/home/test" and .entries == []' \
  <<<"$remote_listing" >/dev/null

if PATH="$fake_bin:$PATH" FAKE_SSH_OUTPUT=oversized-stdout \
    "$helper" ssh test-host list / > "$test_root/stdout-limit.json"; then
  echo "Directory picker unexpectedly accepted oversized SSH stdout" >&2
  exit 1
fi
jq -e '.error == "SSH stdout exceeded the 16 MiB limit"' \
  "$test_root/stdout-limit.json" >/dev/null

if PATH="$fake_bin:$PATH" FAKE_SSH_OUTPUT=oversized-stderr \
    "$helper" ssh test-host list / > "$test_root/stderr-limit.json"; then
  echo "Directory picker unexpectedly accepted oversized SSH stderr" >&2
  exit 1
fi
jq -e '.error == "SSH stderr exceeded the 256 KiB limit"' \
  "$test_root/stderr-limit.json" >/dev/null

printf '%s\n' "directory-picker tests passed"

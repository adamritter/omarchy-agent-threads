#!/usr/bin/env bash

set -euo pipefail

test_root="$(mktemp -d -t codex-threads-claude-XXXXXX)"
trap 'rm -rf -- "$test_root"' EXIT
fake_home="$test_root/home"
state_home="$test_root/state"
project_dir="$fake_home/.claude/projects/-work"
work_dir="$fake_home/work"
session_id="11111111-2222-4333-8444-555555555555"
transcript="$project_dir/${session_id}.jsonl"
helper="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/bin/omarchy-agent-provider-query"

mkdir -p -- "$project_dir" "$work_dir/.claude/agents" "$fake_home/.claude/agents" \
  "$state_home/omarchy"
printf '%s\n' \
  '{"primary":{"usedPercent":12,"resetsAt":1999999999,"windowDurationMins":300},"secondary":{"usedPercent":34,"resetsAt":1999999999,"windowDurationMins":10080},"updatedAt":1787434000000}' \
  > "$state_home/omarchy/claude-usage.json"
printf '%s\n' '{"model":"claude-custom-default","effortLevel":"xhigh","agent":"global-reviewer"}' \
  > "$fake_home/.claude/settings.json"
printf '%s\n' \
  '{"additionalModelOptionsCache":[{"value":"claude-fable-test","label":"Fable Test","description":"Fixture model"}]}' \
  > "$fake_home/.claude.json"
printf '%s\n' '{"model":"sonnet","effortLevel":"medium","agent":"project-reviewer"}' \
  > "$work_dir/.claude/settings.local.json"
printf '%s\n' '---' 'name: global-reviewer' 'description: Global review agent' '---' \
  'Review globally.' > "$fake_home/.claude/agents/global-reviewer.md"
printf '%s\n' '---' 'name: project-reviewer' 'description: Project review agent' '---' \
  'Review this project.' > "$work_dir/.claude/agents/project-reviewer.md"
jq -cn --arg sessionId "$session_id" --arg cwd "$work_dir" '{
  sessionId:$sessionId,
  cwd:$cwd,
  timestamp:"2026-08-22T20:00:00.000Z",
  isSidechain:false,
  type:"user",
  message:{role:"user",content:"Implement the provider"}
}' > "$transcript"

run_helper() {
  OMARCHY_AGENT_PROVIDER_HOME="$fake_home" \
    OMARCHY_CLAUDE_COMMAND=/definitely/missing/claude \
    XDG_STATE_HOME="$state_home" \
    node "$helper" claude "$@"
}

snapshot="$(run_helper snapshot)"
jq -e --arg cwd "$work_dir" '
  .defaultModel == "claude-custom-default"
  and .defaultEffort == "xhigh"
  and .defaultAgent == "global-reviewer"
  and .available == false
  and .rateLimits.primary.usedPercent == 12
  and .rateLimits.secondary.usedPercent == 34
  and (.models | any(.id == "claude-fable-test"))
  and (.models | any(.id == "claude-custom-default"))
  and (.threads | length == 1)
  and .threads[0].status.type == "active"
  and .threads[0].lifecycle == "busy"
  and .threads[0].completionToken == ""
  and .threads[0].name == "Implement the provider"
  and .projectDefaults[$cwd].model == "sonnet"
  and .projectDefaults[$cwd].effort == "medium"
  and .projectDefaults[$cwd].agent == "project-reviewer"
  and (.agents | any(.id == "global-reviewer"))
  and (.projectAgents[$cwd] | any(.id == "project-reviewer"))
' <<<"$snapshot" >/dev/null

jq -cn --arg sessionId "$session_id" --arg cwd "$work_dir" '{
  sessionId:$sessionId,
  cwd:$cwd,
  timestamp:"2026-08-22T20:00:05.000Z",
  isSidechain:false,
  type:"assistant",
  effort:"xhigh",
  message:{role:"assistant",model:"claude-opus-test",stop_reason:"end_turn"}
}' >> "$transcript"
snapshot="$(run_helper snapshot)"
jq -e '
  .threads[0].status.type == "idle"
  and .threads[0].lifecycle == "done"
  and (.threads[0].completionToken | startswith("transcript:"))
  and .threads[0].lastModel == "claude-opus-test"
  and .threads[0].lastEffort == "xhigh"
' <<<"$snapshot" >/dev/null

large_session_id="aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
large_transcript="$project_dir/${large_session_id}.jsonl"
jq -cn --arg sessionId "$large_session_id" --arg cwd "$work_dir" '{
  sessionId:$sessionId,
  cwd:$cwd,
  timestamp:"2026-08-22T20:00:10.000Z",
  isSidechain:false,
  type:"user",
  message:{role:"user",content:"Bounded transcript fixture"}
}' > "$large_transcript"
truncate -s 8388608 "$large_transcript"
printf '\n' >> "$large_transcript"
jq -cn --arg sessionId "$large_session_id" --arg cwd "$work_dir" '{
  sessionId:$sessionId,
  cwd:$cwd,
  timestamp:"2026-08-22T20:00:15.000Z",
  isSidechain:false,
  type:"assistant",
  effort:"high",
  message:{role:"assistant",model:"claude-sonnet-test",stop_reason:"end_turn"}
}' >> "$large_transcript"
run_helper snapshot | jq -e --arg id "$large_session_id" '
  .threads[] | select(.id == $id)
  | .name == "Bounded transcript fixture"
    and .lifecycle == "done"
    and .lastModel == "claude-sonnet-test"
' >/dev/null

run_helper pin "$session_id" "" true >/dev/null
run_helper snapshot | jq -e --arg id "$session_id" '
  .threads[] | select(.id == $id) | .isPinned == true
' >/dev/null

run_helper rename "$session_id" "" "Renamed Claude session" >/dev/null
tail -n 1 "$transcript" | jq -e --arg id "$session_id" '
  .type == "custom-title"
  and .customTitle == "Renamed Claude session"
  and .sessionId == $id
' >/dev/null
run_helper snapshot | jq -e --arg id "$session_id" '
  .threads[] | select(.id == $id) | .name == "Renamed Claude session"
' >/dev/null

run_helper archive "$session_id" >/dev/null
run_helper snapshot | jq -e --arg id "$session_id" '
  (.threads | any(.id == $id)) == false
' >/dev/null

auth_fixture="$test_root/authenticated"
fake_claude="$test_root/claude"
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'if [[ "${1:-}" == "--version" ]]; then' \
  '  printf "%s\n" "2.1.999 (Claude Code)"' \
  'elif [[ "${1:-}" == "auth" && "${2:-}" == "status" ]]; then' \
  '  [[ -e "$CLAUDE_AUTH_FIXTURE" ]] && logged_in=true || logged_in=false' \
  '  printf "{\"loggedIn\":%s}\n" "$logged_in"' \
  'fi' > "$fake_claude"
chmod +x "$fake_claude"
export CLAUDE_AUTH_FIXTURE="$auth_fixture"
OMARCHY_AGENT_PROVIDER_HOME="$fake_home" OMARCHY_CLAUDE_COMMAND="$fake_claude" \
  XDG_STATE_HOME="$state_home" node "$helper" claude snapshot \
  | jq -e '.available == true and .authenticated == false' >/dev/null
touch "$auth_fixture"
OMARCHY_AGENT_PROVIDER_HOME="$fake_home" OMARCHY_CLAUDE_COMMAND="$fake_claude" \
  XDG_STATE_HOME="$state_home" node "$helper" claude snapshot \
  | jq -e '.available == true and .authenticated == true' >/dev/null

for index in $(seq -w 1 520); do
  printf '%s\n' \
    "{\"cwd\":\"$work_dir\",\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"Limit fixture $index\"}}" \
    > "$project_dir/limit-$index.jsonl"
done
run_helper snapshot | jq -e '.threads | length <= 512' >/dev/null

printf '%s\n' "claude-provider tests passed"

#!/usr/bin/env bash

set -euo pipefail

plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d -t agent-chat-math-XXXXXX)"
trap 'rm -rf -- "$test_root"' EXIT
mkdir -p -- "$test_root/runtime"

help_output="$("$plugin_root/bin/omarchy-agent-math-render" --help)"
grep -F -- 'internal Agent Chat helper' <<<"$help_output" >/dev/null
grep -F -- "$plugin_root/bin/omarchy-agent-chat" <<<"$help_output" >/dev/null

request='{"requestId":"math-test","content":"Inline $x^2=4$.\n\n$$\\int_0^1 x^2 dx=\\frac{1}{3}$$\n\n```text\n$not_math$\n```"}'
response="$(printf '%s\n' "$request" \
  | TMPDIR="$test_root" XDG_RUNTIME_DIR="$test_root/runtime" \
    "$plugin_root/bin/omarchy-agent-math-render")"

jq -e '
  .requestId == "math-test"
  and (.error == null)
  and ((.markdown | scan("!\\[Math formula\\]")) | length > 0)
  and (.markdown | contains("$not_math$"))
' <<<"$response" >/dev/null

mapfile -t svg_paths < <(jq -r '.markdown | scan("file://[^)]+") | sub("^file://"; "")' \
  <<<"$response")
test "${#svg_paths[@]}" -eq 2
for svg_path in "${svg_paths[@]}"; do
  test -s "$svg_path"
  grep -F -- '<svg' "$svg_path" >/dev/null
  grep -F -- '<path' "$svg_path" >/dev/null
  if grep -F -- 'currentColor' "$svg_path" >/dev/null; then
    printf 'math renderer left unresolved currentColor in %s\n' "$svg_path" >&2
    exit 1
  fi
done

printf 'math renderer tests passed\n'

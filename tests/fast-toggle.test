#!/usr/bin/env bash

set -euo pipefail

plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d -t agent-fast-toggle-XXXXXX)"
trap 'rm -rf -- "$test_root"' EXIT
mkdir -p -- "$test_root/bin"

cat >"$test_root/bin/omarchy-shell" <<'EOF'
#!/usr/bin/env bash
if [[ "${2:-}" == "status" ]]; then
  printf '%s\n' "$SIDEBAR_STATUS"
else
  printf 'shell %s\n' "$*" >>"$FAST_TOGGLE_LOG"
fi
EOF
cat >"$test_root/bin/hyprctl" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$ACTIVE_WINDOW"
EOF
cat >"$test_root/bin/quickshell" <<'EOF'
#!/usr/bin/env bash
printf 'chat %s\n' "$*" >>"$FAST_TOGGLE_LOG"
EOF
cat >"$test_root/bin/omarchy-hyprland-window-tiled-fullscreen-toggle" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' fullscreen >>"$FAST_TOGGLE_LOG"
EOF
chmod +x "$test_root/bin/"*

export PATH="$test_root/bin:$PATH"
export FAST_TOGGLE_LOG="$test_root/actions.log"

run_toggle() {
  : >"$FAST_TOGGLE_LOG"
  "$plugin_root/bin/omarchy-agent-fast-toggle"
}

export SIDEBAR_STATUS='{"sidebarFocused":true,"activeProvider":"codex"}'
export ACTIVE_WINDOW='{"class":"fixture","title":"Fixture"}'
run_toggle
grep -F -- 'shell adam.codex-threads fast toggle' "$FAST_TOGGLE_LOG" >/dev/null
[[ "$(wc -l <"$FAST_TOGGLE_LOG")" == "1" ]]

export SIDEBAR_STATUS='{"sidebarFocused":false,"activeProvider":"codex"}'
export ACTIVE_WINDOW='{"class":"org.omarchy.agent-chat","title":"Agent Chat · thread"}'
run_toggle
grep -F -- "chat ipc --path $plugin_root/agent-chat.qml call agentChat fast toggle" \
  "$FAST_TOGGLE_LOG" >/dev/null
[[ "$(wc -l <"$FAST_TOGGLE_LOG")" == "1" ]]

export ACTIVE_WINDOW='{"class":"fixture","title":"Fixture"}'
run_toggle
grep -Fx -- fullscreen "$FAST_TOGGLE_LOG" >/dev/null
[[ "$(wc -l <"$FAST_TOGGLE_LOG")" == "1" ]]

printf '%s\n' 'fast-toggle tests passed'

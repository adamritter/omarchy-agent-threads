#!/usr/bin/env bash

set -euo pipefail

plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d -t agent-threads-workspace-state-XXXXXX)"
trap 'rm -rf -- "$test_root"' EXIT

mkdir -p -- "$test_root/bin"

cat >"$test_root/bin/hyprctl" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  activeworkspace)
    printf '%s\n' '{"id":1,"name":"1","monitorID":0,"hasfullscreen":false}'
    ;;
  monitors)
    if [[ "${WORKSPACE_FIXTURE_MODE:-special}" == "special" ]]; then
      printf '%s\n' '[{"id":0,"x":0,"y":0,"width":1600,"height":900,"scale":1,"specialWorkspace":{"id":-98,"name":"special:scratchpad"}}]'
    else
      printf '%s\n' '[{"id":0,"x":0,"y":0,"width":1600,"height":900,"scale":1,"specialWorkspace":{"id":0,"name":""}}]'
    fi
    ;;
  workspaces)
    printf '%s\n' '[{"id":1,"name":"1","monitorID":0,"hasfullscreen":false},{"id":-98,"name":"special:scratchpad","monitorID":0,"hasfullscreen":true}]'
    ;;
  clients)
    printf '%s\n' '[]'
    ;;
  *)
    exit 1
    ;;
esac
EOF
chmod +x "$test_root/bin/hyprctl"

special="$(PATH="$test_root/bin:$PATH" "$plugin_root/bin/omarchy-agent-workspace-state")"
jq -e '
  .workspaceId == -98
  and .workspaceKey == "special:scratchpad"
  and .workspaceName == "special:scratchpad"
  and .specialWorkspace == true
  and .nativeFullscreen == true
  and .hasfullscreen == true
' <<<"$special" >/dev/null

normal="$(WORKSPACE_FIXTURE_MODE=normal PATH="$test_root/bin:$PATH" \
  "$plugin_root/bin/omarchy-agent-workspace-state")"
jq -e '
  .workspaceId == 1
  and .workspaceKey == "1"
  and .workspaceName == "1"
  and .specialWorkspace == false
  and .nativeFullscreen == false
  and .hasfullscreen == false
' <<<"$normal" >/dev/null

printf '%s\n' 'workspace-state tests passed'

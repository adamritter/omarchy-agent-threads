#!/usr/bin/env bash

set -euo pipefail

plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d -t agent-effort-cycle-XXXXXX)"
trap 'rm -rf -- "$test_root"' EXIT
mkdir -p -- "$test_root/bin"

cat >"$test_root/bin/omarchy-shell" <<'EOF'
#!/usr/bin/env bash
if [[ "${2:-}" == "status" ]]; then
  printf '%s\n' "$SIDEBAR_STATUS"
else
  printf 'shell %s\n' "$*" >>"$EFFORT_CYCLE_LOG"
fi
EOF
cat >"$test_root/bin/hyprctl" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$ACTIVE_WINDOW"
EOF
cat >"$test_root/bin/quickshell" <<'EOF'
#!/usr/bin/env bash
printf 'chat %s\n' "$*" >>"$EFFORT_CYCLE_LOG"
EOF
chmod +x "$test_root/bin/"*

export PATH="$test_root/bin:$PATH"
export EFFORT_CYCLE_LOG="$test_root/actions.log"

run_cycle() {
  : >"$EFFORT_CYCLE_LOG"
  "$plugin_root/bin/omarchy-agent-effort-cycle"
}

export ACTIVE_WINDOW='{"class":"fixture","title":"Fixture"}'
export SIDEBAR_STATUS='{"sidebarFocused":true,"renameOpen":false}'
run_cycle
grep -F -- 'shell adam.codex-threads effort cycle' "$EFFORT_CYCLE_LOG" >/dev/null
[[ "$(wc -l <"$EFFORT_CYCLE_LOG")" == "1" ]]

export SIDEBAR_STATUS='{"sidebarFocused":true,"renameOpen":true}'
run_cycle
grep -F -- 'shell shell toggle omarchy.emojis' "$EFFORT_CYCLE_LOG" >/dev/null
[[ "$(wc -l <"$EFFORT_CYCLE_LOG")" == "1" ]]

export SIDEBAR_STATUS='{"sidebarFocused":false,"renameOpen":false}'
export ACTIVE_WINDOW='{"class":"org.omarchy.agent-chat","title":"Agent Chat · thread"}'
run_cycle
grep -F -- "chat ipc --path $plugin_root/agent-chat.qml call agentChat effort cycle" \
  "$EFFORT_CYCLE_LOG" >/dev/null
[[ "$(wc -l <"$EFFORT_CYCLE_LOG")" == "1" ]]

export ACTIVE_WINDOW='{"class":"fixture","title":"Fixture"}'
run_cycle
grep -F -- 'shell shell toggle omarchy.emojis' "$EFFORT_CYCLE_LOG" >/dev/null
[[ "$(wc -l <"$EFFORT_CYCLE_LOG")" == "1" ]]

printf '%s\n' 'effort-cycle tests passed'

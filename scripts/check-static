#!/usr/bin/env bash
# Purpose: Checks source structure, imports, documentation headers, and maintainability constraints.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
plugin_dir="$(cd -- "${script_dir}/.." && pwd)"

omarchy plugin validate "$plugin_dir"

while IFS= read -r file; do
  bash -n "$file"
done < <(find "$plugin_dir/bin" "$plugin_dir/chat/bin" -type f \
  -exec grep -Il '^#!/.*bash' {} \; | sort)

while IFS= read -r file; do
  node --check "$file"
done < <(find "$plugin_dir/bin" "$plugin_dir/chat/bin" -maxdepth 1 -type f \
  -exec grep -Il '^#!/usr/bin/env node' {} \; | sort)

while IFS= read -r file; do
  qmllint "$file"
done < <(find "$plugin_dir/services" "$plugin_dir/providers" \
  "$plugin_dir/ui" "$plugin_dir/chat/ui" "$plugin_dir/chat/providers" \
  -type f -name '*.qml' | sort)

qmllint "$plugin_dir/agent-chat.qml"

while IFS= read -r file; do
  qmllint "$file"
done < <(find "$plugin_dir/logic" "$plugin_dir/chat/logic" \
  -maxdepth 1 -type f -name '*.js' | sort)

undocumented_sources=""
while IFS= read -r -d '' file; do
  case "$file" in
    *.qml|*.js|*.mjs|*.sh|*.cpp|*.css|*.html|*.test|*/qmldir) ;;
    "$plugin_dir/bin/"*|"$plugin_dir/chat/bin/"*|"$plugin_dir/scripts/"*) ;;
    *) continue ;;
  esac
  if ! head -n 6 "$file" | grep -Eq '^(#|//|/\*|<!--) Purpose:'; then
    undocumented_sources+="${file#"$plugin_dir/"}"$'\n'
  fi
done < <(find "$plugin_dir/Panel.qml" "$plugin_dir/agent-chat.qml" \
  "$plugin_dir/ARCHITECTURE.html" "$plugin_dir/bin" "$plugin_dir/chat" \
  "$plugin_dir/logic" "$plugin_dir/providers" "$plugin_dir/services" \
  "$plugin_dir/ui" "$plugin_dir/tests" "$plugin_dir/scripts" -type f \
  ! -path '*/node_modules/*' ! -path '*/vendor/*' \
  ! -name 'LICENSE*' ! -name '*.bak.*' -print0)

if [[ -n "$undocumented_sources" ]]; then
  printf '%s\n' 'Maintained source files need a concise Purpose header:' >&2
  printf '%s' "$undocumented_sources" >&2
  exit 1
fi

oversized_sources=""
while IFS= read -r -d '' file; do
  size="$(wc -c <"$file")"
  if (( size >= 10000 )) && grep -Iq . "$file"; then
    oversized_sources+="$(printf '%s\t%s' "$size" "${file#"$plugin_dir/"}")"$'\n'
  fi
done < <(find "$plugin_dir/Panel.qml" "$plugin_dir/agent-chat.qml" \
  "$plugin_dir/bin" "$plugin_dir/chat" "$plugin_dir/logic" \
  "$plugin_dir/providers" "$plugin_dir/services" "$plugin_dir/ui" \
  "$plugin_dir/tests" "$plugin_dir/scripts" -type f \
  ! -path '*/node_modules/*' ! -path '*/vendor/*' \
  ! -name 'LICENSE*' ! -name '*.bak.*' -print0)

if [[ -n "$oversized_sources" ]]; then
  printf '%s\n' 'Maintained source files must stay below 10,000 bytes:' >&2
  printf '%s' "$oversized_sources" >&2
  exit 1
fi

printf 'Static checks passed.\n'

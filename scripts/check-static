#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
plugin_dir="$(cd -- "${script_dir}/.." && pwd)"

omarchy plugin validate "$plugin_dir"

while IFS= read -r file; do
  bash -n "$file"
done < <(find "$plugin_dir/bin" -maxdepth 1 -type f -exec grep -Il '^#!/.*bash' {} \; | sort)

while IFS= read -r file; do
  node --check "$file"
done < <(find "$plugin_dir/bin" -maxdepth 1 -type f -exec grep -Il '^#!/usr/bin/env node' {} \; | sort)

while IFS= read -r file; do
  qmllint "$file"
done < <(find "$plugin_dir/services" "$plugin_dir/providers" "$plugin_dir/ui" \
  -maxdepth 1 -type f -name '*.qml' | sort)

printf 'Static checks passed.\n'

#!/usr/bin/env bash
# Purpose: Requests and verifies an in-process QML graph reload of the plugin.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
plugin_target="adam.codex-threads"
ipc_timeout="${RELOAD_IPC_TIMEOUT:-0.5s}"
status_deadline_seconds="${RELOAD_STATUS_DEADLINE_SECONDS:-10}"

if [[ "${RELOAD_SKIP_STATIC_CHECK:-0}" != "1" ]]; then
  "$script_dir/check-static"
fi

plugin_status() {
  OMARCHY_SHELL_IPC_TIMEOUT="$ipc_timeout" \
    omarchy-shell "$plugin_target" status 2>/dev/null
}

wait_for_status() {
  local deadline=$((SECONDS + status_deadline_seconds)) status
  while (( SECONDS < deadline )); do
    if status="$(plugin_status)"; then
      printf '%s\n' "$status"
      return 0
    fi
    sleep 0.1
  done
  return 1
}

request_qml_reload() {
  local response
  response="$(OMARCHY_SHELL_IPC_TIMEOUT="$ipc_timeout" \
    omarchy-shell "$plugin_target" reloadQml 2>&1)" || return 1
  [[ "$response" == "ok" ]]
}

status_before="$(plugin_status || true)"
mapfile -t before_fields < <(jq -r '[.instanceToken // "", .sidebarPresented // false][]' \
  <<<"$status_before" 2>/dev/null || true)
token_before="${before_fields[0]:-}"
presented_before="${before_fields[1]:-false}"

# Older installed revisions do not expose reloadQml yet. A rescan upgrades the
# entry component first; subsequent development reloads take the fast path.
if ! request_qml_reload; then
  OMARCHY_SHELL_IPC_TIMEOUT="$ipc_timeout" omarchy-shell shell rescanPlugins
  if ! status_before="$(wait_for_status)"; then
    printf '%s\n' 'Plugin IPC target did not return after rescan.' >&2
    exit 1
  fi
  mapfile -t before_fields < <(jq -r \
    '[.instanceToken // "", .sidebarPresented // false][]' <<<"$status_before")
  token_before="${before_fields[0]:-}"
  presented_before="${before_fields[1]:-false}"
  if ! request_qml_reload; then
    printf '%s\n' 'Plugin does not expose the in-process QML reload method.' >&2
    exit 1
  fi
fi

deadline=$((SECONDS + status_deadline_seconds))
while (( SECONDS < deadline )); do
  status_after="$(plugin_status || true)"
  mapfile -t after_fields < <(jq -r '[
    .instanceToken // "",
    .ready // false,
    (if .providerLoading == false then false else true end),
    (if .loading == false then false else true end),
    .sidebarPresented // false,
    .providerSnapshotRestored // false
  ][]' <<<"$status_after" 2>/dev/null || true)
  token_after="${after_fields[0]:-}"
  ready_after="${after_fields[1]:-false}"
  provider_loading_after="${after_fields[2]:-true}"
  loading_after="${after_fields[3]:-true}"
  presented_after="${after_fields[4]:-false}"
  snapshot_restored_after="${after_fields[5]:-false}"
  backend_ready_after=false
  if [[ "$ready_after" == "true" && "$provider_loading_after" == "false"
      && "$loading_after" == "false" ]]; then
    backend_ready_after=true
  fi
  if [[ -n "$token_after" && "$token_after" != "$token_before"
      && ("$presented_before" != "true" || "$presented_after" == "true")
      && ("$snapshot_restored_after" == "true" || "$backend_ready_after" == "true") ]]; then
    printf '%s\n' "$status_after"
    exit 0
  fi
  sleep 0.1
done

printf '%s\n' 'In-process QML reload did not become ready before the deadline.' >&2
exit 1

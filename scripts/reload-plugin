#!/usr/bin/env bash

set -euo pipefail

plugin_target="adam.codex-threads"

plugin_status() {
  omarchy-shell "$plugin_target" status 2>/dev/null
}

wait_for_status() {
  local attempt status
  for ((attempt = 0; attempt < 50; attempt++)); do
    if status="$(plugin_status)"; then
      printf '%s\n' "$status"
      return 0
    fi
    sleep 0.1
  done
  return 1
}

request_qml_reload() {
  local response
  response="$(omarchy-shell "$plugin_target" reloadQml 2>&1)" || return 1
  [[ "$response" == "ok" ]]
}

status_before="$(plugin_status || true)"
token_before="$(jq -r '.instanceToken // empty' <<<"$status_before" 2>/dev/null || true)"
presented_before="$(jq -r '.sidebarPresented // false' <<<"$status_before" 2>/dev/null || true)"

# Older installed revisions do not expose reloadQml yet. A rescan upgrades the
# entry component first; subsequent development reloads take the fast path.
if ! request_qml_reload; then
  omarchy-shell shell rescanPlugins
  status_before="$(wait_for_status)"
  token_before="$(jq -r '.instanceToken // empty' <<<"$status_before")"
  presented_before="$(jq -r '.sidebarPresented // false' <<<"$status_before")"
  request_qml_reload
fi

for ((attempt = 0; attempt < 100; attempt++)); do
  status_after="$(plugin_status || true)"
  token_after="$(jq -r '.instanceToken // empty' <<<"$status_after" 2>/dev/null || true)"
  ready_after="$(jq -r '.ready // false' <<<"$status_after" 2>/dev/null || true)"
  provider_loading_after="$(jq -r 'if .providerLoading == false then "false" else "true" end' \
    <<<"$status_after" 2>/dev/null || true)"
  loading_after="$(jq -r 'if .loading == false then "false" else "true" end' \
    <<<"$status_after" 2>/dev/null || true)"
  presented_after="$(jq -r '.sidebarPresented // false' <<<"$status_after" 2>/dev/null || true)"
  if [[ -n "$token_after" && "$token_after" != "$token_before"
      && "$ready_after" == "true"
      && "$provider_loading_after" == "false"
      && "$loading_after" == "false"
      && ("$presented_before" != "true" || "$presented_after" == "true") ]]; then
    printf '%s\n' "$status_after"
    exit 0
  fi
  sleep 0.1
done

printf '%s\n' 'In-process QML reload did not produce a new panel generation; restarting the shell.' >&2
omarchy restart shell
wait_for_status
